apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{.Project}}
resources:
  - ../../base
images:
{{- range .Images}}
  - name: {{.}}
    newName: registry.example.com/{{.}}
    newTag: latest
{{- end}}
patches:
  - path: deployments.yaml
configMapGenerator:
{{- range .Workloads}}
  - name: {{.Name}}-config
    behavior: merge
    literals:
      - LOG_LEVEL=info
{{- end}}
