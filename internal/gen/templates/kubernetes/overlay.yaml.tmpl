apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{.Project}}
resources:
  - ../../base
{{- if .Observability}}
components:
  - ../../components/observability
{{- end}}
images:
{{- range .Images}}
  - name: {{.}}
    newName: registry.example.com/{{.}}
    newTag: latest
{{- end}}
patches:
  - path: deployments.yaml
configMapGenerator:
{{- range .Workloads}}
  - name: {{.Name}}-config
    behavior: merge
    literals:
      - LOG_LEVEL=info
{{- if $.Observability}}
      - OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
{{- if and $.Ops (or (eq .Component "api") (eq .Component "gateway"))}}
      - OPS_JAEGER_URL=http://jaeger:16686
{{- end}}
{{- end}}
{{- end}}
