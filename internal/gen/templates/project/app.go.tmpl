{{.Header}}

package app

import (
	"database/sql"
	"log/slog"
	"net/http"
	"os"
{{range .Wired}}
	"{{.Import}}"
{{- end}}
{{- if .Auth}}
{{- if not .Auth.Wired}}
	"{{.Auth.Import}}"
{{- end}}
	"{{.Module}}/internal/platform/auth"
{{- end}}
{{- if .Wired}}
	"{{.Module}}/internal/platform/database"
{{- end}}
	"{{.Module}}/internal/platform/httpx"
{{- if .Ops}}
	"{{.Module}}/internal/platform/ops"
{{- end}}
)

func RegisterRoutes(mux *http.ServeMux, db *sql.DB, logger *slog.Logger) error {
	rateLimits, err := httpx.LoadRateLimits(os.Getenv)
	if err != nil {
		return err
	}
	limiter := httpx.NewRateLimiter(rateLimits, logger)
	mux.HandleFunc("GET /openapi.json", limiter.Limit(serveOpenAPI))
{{- if .Wired}}
	idem := database.NewIdempotency(db)
{{- end}}
{{- if .Auth}}
	cfg, err := auth.LoadConfig(os.Getenv)
	if err != nil {
		return err
	}
	accounts := {{.Auth.Package}}.NewAccounts(db, cfg)
	guard, err := auth.NewGuard(accounts.Authenticate, cfg, logger)
	if err != nil {
		return err
	}
	guard.UseRateLimits(limiter)
	var limits auth.LimitStore = auth.NewMemoryStore()
	if cfg.LimitStore == auth.LimitStoreDatabase {
		limits = {{.Auth.Package}}.NewLimitStore(db)
	}
	{{.Auth.Package}}.RegisterAuthRoutes(mux, {{.Auth.Package}}.NewAuthHandler({{.Auth.Package}}.NewAuthService(db, accounts), guard, cfg, logger, limits))
{{- end}}
{{- if .Ops}}
	opsConfig, err := ops.LoadConfig(os.Getenv)
	if err != nil {
		return err
	}
	ops.Register(mux, opsConfig, guard, logger)
{{- end}}
{{- range .Wired}}
	{{.Package}}.RegisterRoutes(mux, {{.Package}}.NewHandler({{.Package}}.NewService(db), logger).UseIdempotency(idem){{if $.Auth}}, guard{{else}}.UseRateLimits(limiter){{end}})
{{- end}}
	return nil
}
