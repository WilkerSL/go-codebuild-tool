{{.Header}}

package app

import (
	"database/sql"
	"log/slog"
	"net/http"
{{- if .Auth}}
	"os"
{{- end}}
{{range .Wired}}
	"{{.Import}}"
{{- end}}
{{- if .Auth}}
{{- if not .Auth.Wired}}
	"{{.Auth.Import}}"
{{- end}}
	"{{.Module}}/internal/platform/auth"
{{- end}}
	"{{.Module}}/internal/platform/database"
)

func RegisterRoutes(mux *http.ServeMux, db *sql.DB, logger *slog.Logger) error {
	mux.HandleFunc("GET /openapi.json", serveOpenAPI)
	idem := database.NewIdempotency(db)
{{- if .Auth}}
	cfg, err := auth.LoadConfig(os.Getenv)
	if err != nil {
		return err
	}
	accounts := {{.Auth.Package}}.NewAccounts(db, cfg)
	guard, err := auth.NewGuard(accounts.Authenticate, cfg, logger)
	if err != nil {
		return err
	}
	var limits auth.LimitStore = auth.NewMemoryStore()
	if cfg.LimitStore == auth.LimitStoreDatabase {
		limits = {{.Auth.Package}}.NewLimitStore(db)
	}
	{{.Auth.Package}}.RegisterAuthRoutes(mux, {{.Auth.Package}}.NewAuthHandler({{.Auth.Package}}.NewAuthService(db, accounts), guard, cfg, logger, limits))
{{- end}}
{{- range .Wired}}
	{{.Package}}.RegisterRoutes(mux, {{.Package}}.NewHandler({{.Package}}.NewService(db), logger).UseIdempotency(idem){{if $.Auth}}, guard{{end}})
{{- end}}
	return nil
}
