name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
{{- if .CI.Services}}
    services:
{{.CI.Services}}
{{- end}}
{{- if .CI.TestDatabaseURL}}
    env:
      TEST_DATABASE_URL: {{.CI.TestDatabaseURL}}
{{- end}}
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-go@v7
        with:
          go-version-file: go.mod
{{- if .CI.Setup}}
{{.CI.Setup}}
{{- end}}
      - name: Verify modules
        run: go mod verify
      - name: Format
        run: test -z "$(gofmt -l .)"
      - name: Vet
        run: go vet ./...
      - name: Test
        run: go test -race -count=1 ./...
      - name: Known vulnerabilities
        run: go run golang.org/x/vuln/cmd/govulncheck@latest ./...
      - name: Generated code is up to date
        run: |
          if grep -q "go-codebuild-tool/cmd/codebuild" go.mod; then
            go tool codebuild plan --exit-code
          fi
      - name: Container image
        run: docker build -t app .
