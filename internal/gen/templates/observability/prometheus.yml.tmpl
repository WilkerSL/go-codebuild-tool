{{.YAMLHeader}}

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: {{.Project}}
    static_configs:
{{- range .Targets}}
      - targets: ["{{.Address}}"]
        labels:
          project: {{$.Project}}
          service: {{.Service}}
{{- end}}
  - job_name: jaeger
    static_configs:
      - targets: ["jaeger:8889"]
