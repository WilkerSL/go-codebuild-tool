{{.YAMLHeader}}

service:
  extensions: [jaeger_storage, jaeger_query, healthcheckv2]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [jaeger_storage_exporter, spanmetrics]
    metrics/spanmetrics:
      receivers: [spanmetrics]
      exporters: [prometheus]
  telemetry:
    resource:
      service.name: jaeger
    logs:
      level: info

extensions:
  healthcheckv2:
    use_v2: true
    http:
      endpoint: 0.0.0.0:13133
  jaeger_query:
    base_path: /_ops/jaeger
    http:
      endpoint: 0.0.0.0:16686
    storage:
      traces: traces
      metrics: metrics
    ui:
      config_file: /etc/jaeger/ui.json
  jaeger_storage:
    backends:
      traces:
        memory:
          max_traces: 100000
    metric_backends:
      metrics:
        prometheus:
          endpoint: ${env:PROMETHEUS_URL:-http://prometheus:9090/_ops/prometheus}
          normalize_calls: true
          normalize_duration: true

connectors:
  spanmetrics:
    metrics_flush_interval: 15s

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:

exporters:
  jaeger_storage_exporter:
    trace_storage: traces
  prometheus:
    endpoint: 0.0.0.0:8889
