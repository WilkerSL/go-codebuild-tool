package httpx

import (
{{- if .Caps.JSONv2}}
	"encoding/json/jsontext"
	"encoding/json/v2"
{{- else}}
	"bytes"
	"encoding/json"
{{- end}}
	"errors"
	"fmt"
	"io"
	"mime"
	"net/http"
	"strings"

	"{{.Module}}/internal/platform/validation"
)

const MaxBodyBytes = 1 << 20

func WriteJSON(w http.ResponseWriter, status int, v any) {
	writeEncoded(w, status, "application/json", v)
}

func requireJSON(r *http.Request) error {
	mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
	if err != nil || (mediaType != "application/json" && !strings.HasSuffix(mediaType, "+json")) {
		return NewError(http.StatusUnsupportedMediaType, "the request body must be sent with Content-Type: application/json")
	}
	return nil
}

func writeEncoded(w http.ResponseWriter, status int, contentType string, v any) {
	body, err := json.Marshal(v)
	if err != nil {
		status, contentType = http.StatusInternalServerError, problemContentType
		body = []byte(`{"type":"about:blank","title":"Internal Server Error","status":500}`)
	}
	w.Header().Set("Content-Type", contentType)
	w.WriteHeader(status)
	w.Write(append(body, '\n'))
}
func membersError(err error) error {
	if err != nil {
		return decodeError(err)
	}
	return BadRequest("the request body must be a JSON object")
}

{{if .Caps.JSONv2}}
func DecodeJSON(w http.ResponseWriter, r *http.Request, dst any) error {
	if err := requireJSON(r); err != nil {
		return err
	}
	if err := json.UnmarshalRead(http.MaxBytesReader(w, r.Body, MaxBodyBytes), dst, json.RejectUnknownMembers(true)); err != nil {
		return decodeError(err)
	}
	return nil
}

func DecodePatch(w http.ResponseWriter, r *http.Request, dst any) (map[string]bool, error) {
	if err := requireJSON(r); err != nil {
		return nil, err
	}
	data, err := io.ReadAll(http.MaxBytesReader(w, r.Body, MaxBodyBytes))
	if err != nil {
		return nil, decodeError(err)
	}
	var members map[string]jsontext.Value
	if err := json.Unmarshal(data, &members); err != nil || members == nil {
		return nil, membersError(err)
	}
	if err := json.Unmarshal(data, dst, json.RejectUnknownMembers(true)); err != nil {
		return nil, decodeError(err)
	}
	present := make(map[string]bool, len(members))
	for name := range members {
		present[name] = true
	}
	return present, nil
}

func decodeError(err error) error {
	if maxErr, ok := errors.AsType[*http.MaxBytesError](err); ok {
		return NewError(http.StatusRequestEntityTooLarge, fmt.Sprintf("the request body must not exceed %d bytes", maxErr.Limit))
	}
	if semErr, ok := errors.AsType[*json.SemanticError](err); ok {
		field := strings.TrimPrefix(string(semErr.JSONPointer), "/")
		switch {
		case errors.Is(semErr.Err, json.ErrUnknownName):
			return BadRequest("the request body contains unknown fields", validation.FieldError{Field: field, Message: "is not allowed"})
		case field == "":
			return BadRequest("the request body must be a JSON object")
		}
		return BadRequest("the request body contains invalid fields", validation.FieldError{Field: field, Message: "has an invalid type or value"})
	}
	if errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.EOF) {
		return BadRequest("the request body must contain a complete JSON object")
	}
	if synErr, ok := errors.AsType[*jsontext.SyntacticError](err); ok {
		return BadRequest(fmt.Sprintf("the request body contains malformed JSON at offset %d", synErr.ByteOffset))
	}
	return BadRequest("the request body is invalid")
}
{{else}}
func DecodeJSON(w http.ResponseWriter, r *http.Request, dst any) error {
	if err := requireJSON(r); err != nil {
		return err
	}
	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, MaxBodyBytes))
	dec.DisallowUnknownFields()
	if err := dec.Decode(dst); err != nil {
		return decodeError(err)
	}
	if err := dec.Decode(&struct{}{}); !errors.Is(err, io.EOF) {
		return BadRequest("the request body must contain a single JSON object")
	}
	return nil
}

func DecodePatch(w http.ResponseWriter, r *http.Request, dst any) (map[string]bool, error) {
	if err := requireJSON(r); err != nil {
		return nil, err
	}
	data, err := io.ReadAll(http.MaxBytesReader(w, r.Body, MaxBodyBytes))
	if err != nil {
		return nil, decodeError(err)
	}
	var members map[string]json.RawMessage
	if err := json.Unmarshal(data, &members); err != nil || members == nil {
		return nil, membersError(err)
	}
	dec := json.NewDecoder(bytes.NewReader(data))
	dec.DisallowUnknownFields()
	if err := dec.Decode(dst); err != nil {
		return nil, decodeError(err)
	}
	present := make(map[string]bool, len(members))
	for name := range members {
		present[name] = true
	}
	return present, nil
}

func decodeError(err error) error {
	if maxErr, ok := errors.AsType[*http.MaxBytesError](err); ok {
		return NewError(http.StatusRequestEntityTooLarge, fmt.Sprintf("the request body must not exceed %d bytes", maxErr.Limit))
	}
	if syntaxErr, ok := errors.AsType[*json.SyntaxError](err); ok {
		return BadRequest(fmt.Sprintf("the request body contains malformed JSON at offset %d", syntaxErr.Offset))
	}
	if typeErr, ok := errors.AsType[*json.UnmarshalTypeError](err); ok {
		if typeErr.Field == "" {
			return BadRequest("the request body must be a JSON object")
		}
		return BadRequest("the request body contains invalid fields", validation.FieldError{Field: typeErr.Field, Message: "has an invalid type or value"})
	}
	if name, ok := strings.CutPrefix(err.Error(), "json: unknown field "); ok {
		return BadRequest("the request body contains unknown fields", validation.FieldError{Field: strings.Trim(name, `"`), Message: "is not allowed"})
	}
	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
		return BadRequest("the request body must contain a complete JSON object")
	}
	return BadRequest("the request body is invalid")
}
