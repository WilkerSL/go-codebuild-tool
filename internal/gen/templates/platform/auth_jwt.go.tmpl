{{.Header}}

package auth

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/base64"
{{- if .Caps.JSONv2}}
	"encoding/json/v2"
{{- else}}
	"encoding/json"
{{- end}}
	"fmt"
	"strings"
	"time"
)

const MinSecretLength = 32

type Claims struct {
	Subject string `json:"sub"`
{{- if .Auth.Role}}
	Role string `json:"role"`
{{- end}}
	Session   string `json:"sid"`
	ID        string `json:"jti"`
	IssuedAt  int64  `json:"iat"`
	ExpiresAt int64  `json:"exp"`
}

var jwtHeader = base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"HS256","typ":"JWT"}`))

func jwtSignature(secret []byte, signed string) []byte {
	mac := hmac.New(sha256.New, secret)
	mac.Write([]byte(signed))
	return mac.Sum(nil)
}

func SignJWT(secret []byte, c Claims) (string, error) {
	payload, err := json.Marshal(c)
	if err != nil {
		return "", fmt.Errorf("auth: encode claims: %w", err)
	}
	signed := jwtHeader + "." + base64.RawURLEncoding.EncodeToString(payload)
	return signed + "." + base64.RawURLEncoding.EncodeToString(jwtSignature(secret, signed)), nil
}

func ParseJWT(token string, now time.Time, secrets ...[]byte) (Claims, error) {
	header, rest, ok := strings.Cut(token, ".")
	if !ok || header != jwtHeader {
		return Claims{}, ErrInvalidToken
	}
	payload, signature, ok := strings.Cut(rest, ".")
	if !ok || strings.Contains(signature, ".") {
		return Claims{}, ErrInvalidToken
	}
	sig, err := base64.RawURLEncoding.DecodeString(signature)
	if err != nil {
		return Claims{}, ErrInvalidToken
	}
	valid := false
	for _, secret := range secrets {
		if len(secret) > 0 && hmac.Equal(sig, jwtSignature(secret, header+"."+payload)) {
			valid = true
		}
	}
	if !valid {
		return Claims{}, ErrInvalidToken
	}
	data, err := base64.RawURLEncoding.DecodeString(payload)
	if err != nil {
		return Claims{}, ErrInvalidToken
	}
	var c Claims
	if err := json.Unmarshal(data, &c); err != nil || c.Subject == "" || c.ExpiresAt <= now.Unix() {
		return Claims{}, ErrInvalidToken
	}
	return c, nil
}
