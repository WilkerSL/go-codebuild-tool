var (
	ErrNotFound   = errors.New("database: record not found")
	ErrReferenced = errors.New("database: record is referenced by other records")
)

func Unavailable(err error) bool {
	if errors.Is(err, driver.ErrBadConn) || errors.Is(err, sql.ErrConnDone) {
		return true
	}
	_, ok := errors.AsType[net.Error](err)
	return ok
}

type ConstraintKind int

const (
	UniqueViolation ConstraintKind = iota + 1
	ForeignKeyViolation
	NotNullViolation
)

type ConstraintError struct {
	Kind       ConstraintKind
	Constraint string
	Message    string
	Columns    []string
	PrimaryKey bool
	Field      string
	Err        error
}

func (e *ConstraintError) Error() string {
	kind := "unique"
	switch e.Kind {
	case ForeignKeyViolation:
		kind = "foreign key"
	case NotNullViolation:
		kind = "not null"
	}
	if e.Constraint != "" {
		return fmt.Sprintf("database: %s constraint %s violated: %v", kind, e.Constraint, e.Err)
	}
	return fmt.Sprintf("database: %s constraint violated: %v", kind, e.Err)
}

func (e *ConstraintError) Unwrap() error {
	return e.Err
}

func (e *ConstraintError) HasColumn(column string) bool {
	if slices.Contains(e.Columns, column) {
		return true
	}
	for _, quote := range []string{"'", "\"", "`"} {
		if strings.Contains(e.Message, quote+column+quote) || strings.Contains(e.Message, "."+column+quote) {
			return true
		}
	}
	return false
}

func (e *ConstraintError) Matches(constraint, column string) bool {
	if strings.EqualFold(e.Constraint, constraint) || slices.Contains(e.Columns, column) {
		return true
	}
	for _, quote := range []string{"'", "\"", "`"} {
		if strings.Contains(e.Message, quote+constraint+quote) || strings.Contains(e.Message, "."+constraint+quote) {
			return true
		}
	}
	return false
}

