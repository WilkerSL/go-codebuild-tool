type decodeTarget struct {
	Name  *string `json:"name"`
	Count *int32  `json:"count"`
}

func decode(body string) (decodeTarget, error) {
	var dst decodeTarget
	r := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
	err := DecodeJSON(httptest.NewRecorder(), r, &dst)
	return dst, err
}

func TestDecodeJSON(t *testing.T) {
	got, err := decode(`{"name":"ann","count":3}`)
	if err != nil || *got.Name != "ann" || *got.Count != 3 {
		t.Fatalf("decode valid body: %+v %v", got, err)
	}
	tests := []struct {
		name   string
		body   string
		status int
		field  string
	}{
		{name: "empty", body: "", status: http.StatusBadRequest},
		{name: "malformed", body: `{"name":`, status: http.StatusBadRequest},
		{name: "unknown field", body: `{"nickname":"x"}`, status: http.StatusBadRequest, field: "nickname"},
		{name: "wrong type", body: `{"count":"x"}`, status: http.StatusBadRequest, field: "count"},
		{name: "overflow", body: `{"count":99999999999}`, status: http.StatusBadRequest, field: "count"},
		{name: "not an object", body: `[1]`, status: http.StatusBadRequest},
		{name: "trailing data", body: `{"name":"a"} {"name":"b"}`, status: http.StatusBadRequest},
		{name: "too large", body: `{"name":"` + strings.Repeat("a", MaxBodyBytes) + `"}`, status: http.StatusRequestEntityTooLarge},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			_, err := decode(tt.body)
			httpErr, ok := errors.AsType[*Error](err)
			if !ok || httpErr.Status != tt.status {
				t.Fatalf("decode(%.40q) = %v, want status %d", tt.body, err, tt.status)
			}
			if tt.field != "" && (len(httpErr.Errors) != 1 || httpErr.Errors[0].Field != tt.field) {
				t.Fatalf("decode(%.40q) errors = %+v, want field %s", tt.body, httpErr.Errors, tt.field)
			}
		})
	}
}

func TestWriteError(t *testing.T) {
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	tests := []struct {
		err    error
		status int
		body   string
	}{
		{err: database.ErrNotFound, status: http.StatusNotFound},
		{err: database.ErrReferenced, status: http.StatusConflict},
		{err: validation.Errors{ {Field: "name", Message: "is required"} }, status: http.StatusUnprocessableEntity, body: `"field":"name"`},
		{err: &database.ConstraintError{Kind: database.UniqueViolation, Field: "email"}, status: http.StatusConflict, body: `"field":"email"`},
		{err: BadRequest("bad"), status: http.StatusBadRequest, body: `"detail":"bad"`},
		{err: errors.New("secret failure"), status: http.StatusInternalServerError, body: `"detail":"an unexpected error occurred"`},
	}
	for _, tt := range tests {
		rec := httptest.NewRecorder()
		WriteError(rec, httptest.NewRequest(http.MethodGet, "/things", nil), logger, tt.err)
		if rec.Code != tt.status || rec.Header().Get("Content-Type") != problemContentType {
			t.Errorf("WriteError(%v) status = %d %s", tt.err, rec.Code, rec.Header().Get("Content-Type"))
		}
		body := rec.Body.String()
		if !strings.Contains(body, tt.body) || strings.Contains(body, "secret") || !strings.Contains(body, `"instance":"/things"`) {
			t.Errorf("WriteError(%v) body = %s", tt.err, body)
		}
	}
}

func TestPagination(t *testing.T) {
	var errs validation.Errors
	limit, offset := Pagination(url.Values{}, &errs)
	if limit != DefaultLimit || offset != 0 || len(errs) != 0 {
		t.Fatalf("defaults = %d %d %v", limit, offset, errs)
	}
	limit, offset = Pagination(url.Values{"limit": {"5"}, "offset": {"10"}}, &errs)
	if limit != 5 || offset != 10 || len(errs) != 0 {
		t.Fatalf("explicit = %d %d %v", limit, offset, errs)
	}
	Pagination(url.Values{"limit": {"0"}, "offset": {"-1"}}, &errs)
	Pagination(url.Values{"limit": {"100000"}}, &errs)
	if !errs.Has("limit") || !errs.Has("offset") || len(errs) != 3 {
		t.Fatalf("invalid values not reported: %v", errs)
	}
}

func TestQueryHelpers(t *testing.T) {
	var errs validation.Errors
	q := url.Values{"a": {"x"}, "n": {"7"}, "b": {"true"}, "bad": {"zz"}}
	if v := QueryString(q, "a"); v == nil || *v != "x" {
		t.Fatal("QueryString")
	}
	if QueryString(q, "missing") != nil {
		t.Fatal("QueryString missing")
	}
	if v := QueryInt[int32](q, "n", &errs); v == nil || *v != 7 {
		t.Fatal("QueryInt")
	}
	if v := QueryBool(q, "b", &errs); v == nil || !*v {
		t.Fatal("QueryBool")
	}
	QueryInt[int16](q, "bad", &errs)
	QueryUUID(q, "bad", &errs)
	QueryBool(q, "bad", &errs)
	if len(errs) != 3 {
		t.Fatalf("errors = %v", errs)
	}
}

func TestRecover(t *testing.T) {
	var logs bytes.Buffer
	logger := slog.New(slog.NewTextHandler(&logs, nil))
	h := Recover(logger, AccessLog(logger, http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		panic("boom")
	})))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	if rec.Code != http.StatusInternalServerError || !strings.Contains(logs.String(), "boom") {
		t.Fatalf("status = %d logs = %s", rec.Code, logs.String())
	}
}

func TestRequestID(t *testing.T) {
	var seen string
	h := RequestID(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		seen = RequestIDFrom(r.Context())
	}))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	if len(seen) != 32 || rec.Header().Get(RequestIDHeader) != seen {
		t.Fatalf("generated id = %q, header = %q", seen, rec.Header().Get(RequestIDHeader))
	}
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	req.Header.Set(RequestIDHeader, "upstream-42")
	h.ServeHTTP(httptest.NewRecorder(), req)
	if seen != "upstream-42" {
		t.Fatalf("propagated id = %q", seen)
	}
	req.Header.Set(RequestIDHeader, "bad id\n")
	h.ServeHTTP(httptest.NewRecorder(), req)
	if seen == "bad id\n" || len(seen) != 32 {
		t.Fatalf("invalid id was accepted: %q", seen)
	}
}

func TestLogHandlerAddsRequestID(t *testing.T) {
	var logs bytes.Buffer
	logger := slog.New(NewLogHandler(slog.NewTextHandler(&logs, nil))).With("component", "test")
	h := RequestID(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		logger.InfoContext(r.Context(), "handled")
	}))
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	req.Header.Set(RequestIDHeader, "trace-1")
	h.ServeHTTP(httptest.NewRecorder(), req)
	if !strings.Contains(logs.String(), "request_id=trace-1") || !strings.Contains(logs.String(), "component=test") {
		t.Fatalf("logs = %s", logs.String())
	}
}

func TestHealth(t *testing.T) {
	health := NewHealth(nil, slog.New(slog.NewTextHandler(io.Discard, nil)))
	mux := http.NewServeMux()
	health.RegisterRoutes(mux)
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, LivenessPath, nil))
	if rec.Code != http.StatusOK {
		t.Fatalf("liveness = %d", rec.Code)
	}
	health.Drain()
	rec = httptest.NewRecorder()
	mux.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, ReadinessPath, nil))
	if rec.Code != http.StatusServiceUnavailable {
		t.Fatalf("readiness while draining = %d", rec.Code)
	}
}
