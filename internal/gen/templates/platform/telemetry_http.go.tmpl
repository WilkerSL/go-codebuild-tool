package telemetry

import (
	"net/http"
	"slices"
	"strings"
	"time"
)

type recorder struct {
	http.ResponseWriter
	status int
}

func (r *recorder) WriteHeader(code int) {
	if r.status == 0 {
		r.status = code
	}
	r.ResponseWriter.WriteHeader(code)
}

func (r *recorder) Write(b []byte) (int, error) {
	if r.status == 0 {
		r.status = http.StatusOK
	}
	return r.ResponseWriter.Write(b)
}

func (r *recorder) Unwrap() http.ResponseWriter {
	return r.ResponseWriter
}

func HTTP(mux *http.ServeMux, next http.Handler, untraced ...string) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		_, pattern := mux.Handler(r)
		route := pattern
		if _, path, ok := strings.Cut(pattern, " "); ok {
			route = path
		}
		method := Method(r.Method)
		ctx := r.Context()
		var span *Span
		if !slices.Contains(untraced, r.URL.Path) {
			remote, _ := ParseTraceparent(r.Header.Get(TraceparentHeader))
			remote.State = Tracestate(r.Header.Values(TracestateHeader))
			name := method
			if route != "" {
				name += " " + route
			}
			ctx, span = StartSpan(ctx, name, SpanKindServer, remote)
		}
		rec := &recorder{ResponseWriter: w}
		registered.inFlight.Add(1)
		start := time.Now()
		defer func() {
			registered.inFlight.Add(-1)
			status := rec.status
			if status == 0 {
				status = http.StatusOK
			}
			ObserveHTTP(method, route, status, time.Since(start))
			if span != nil {
				span.SetString("http.request.method", method)
				if route != "" {
					span.SetString("http.route", route)
				}
				span.SetString("url.path", r.URL.Path)
				span.SetInt("http.response.status_code", int64(status))
				if status >= http.StatusInternalServerError {
					span.Fail(http.StatusText(status))
				}
				span.End()
			}
		}()
		next.ServeHTTP(rec, r.WithContext(ctx))
	})
}

func Method(m string) string {
	switch m {
	case http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodOptions, http.MethodConnect, http.MethodTrace:
		return m
	}
	return "_OTHER"
}
