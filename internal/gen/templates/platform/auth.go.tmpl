package auth

import (
	"context"
	"fmt"
	"net"
	"net/http"
	"strings"
	"time"

	"{{.UUIDImport}}"

	"{{.Module}}/internal/platform/httpx"
)

type Method string

const (
{{- if .Auth.Session}}
	MethodSession Method = "session"
{{- end}}
{{- if .Auth.JWT}}
	MethodJWT Method = "jwt"
{{- end}}
{{- if .Auth.APIKey}}
	MethodAPIKey Method = "apikey"
{{- end}}
)

const (
{{- if .Auth.Session}}
	SessionPrefix = "ses_"
{{- end}}
{{- if .Auth.JWT}}
	RefreshPrefix = "rt_"
	RefreshCookie = "refresh_token"
{{- end}}
{{- if .Auth.APIKey}}
	APIKeyPrefix = "key_"
{{- end}}
	CredentialCookie = "{{.Auth.CredentialCookie}}"
	maxTokenLength   = 4096
)

type Principal struct {
	ID {{.Auth.IDType}}
{{- if .Auth.Role}}
	Role string
{{- end}}
	Method       Method
	CredentialID string
}

type Tokens struct {
	AccessToken string    `json:"accessToken"`
	TokenType   string    `json:"tokenType"`
	ExpiresAt   time.Time `json:"expiresAt"`
{{- if .Auth.JWT}}
	RefreshToken     string    `json:"refreshToken"`
	RefreshExpiresAt time.Time `json:"refreshExpiresAt"`
{{- end}}
}

var bearer = http.Header{"Www-Authenticate": {"Bearer"}}

var (
	ErrUnauthenticated    = &httpx.Error{Status: http.StatusUnauthorized, Detail: "authentication is required", Header: bearer}
	ErrInvalidToken       = &httpx.Error{Status: http.StatusUnauthorized, Detail: "the access token is invalid or expired", Header: bearer}
	ErrInvalidCredentials = &httpx.Error{Status: http.StatusUnauthorized, Detail: "the credentials are invalid", Header: bearer}
	ErrForbidden          = httpx.NewError(http.StatusForbidden, "the caller is not allowed to perform this operation")
)

type principalKey struct{}

func WithPrincipal(ctx context.Context, p Principal) context.Context {
	return context.WithValue(ctx, principalKey{}, p)
}

func FromContext(ctx context.Context) (Principal, bool) {
	p, ok := ctx.Value(principalKey{}).(Principal)
	return p, ok
}

func Current(ctx context.Context) (Principal, error) {
	p, ok := FromContext(ctx)
	if !ok {
		return Principal{}, ErrUnauthenticated
	}
	return p, nil
}

func Caller(r *http.Request) string {
	p, ok := FromContext(r.Context())
	if !ok {
		return ""
	}
	return fmt.Sprint(p.ID)
}
{{- if .Auth.JWT}}

type confirmKey struct{}

func WithConfirmation(ctx context.Context) context.Context {
	return context.WithValue(ctx, confirmKey{}, true)
}

func ConfirmationRequired(ctx context.Context) bool {
	confirm, _ := ctx.Value(confirmKey{}).(bool)
	return confirm
}
{{- end}}

func Credential(r *http.Request) (string, bool) {
	if header := r.Header.Get("Authorization"); header != "" {
		scheme, token, ok := strings.Cut(header, " ")
		if !ok || !strings.EqualFold(scheme, "Bearer") {
			return "", false
		}
		return strings.TrimSpace(token), false
	}
	if c, err := r.Cookie(CredentialCookie); err == nil && c.Value != "" {
		return c.Value, true
	}
	return "", false
}

func ClientIP(r *http.Request, trustForwardedFor bool) string {
	if trustForwardedFor {
		if lines := r.Header.Values("X-Forwarded-For"); len(lines) > 0 {
			hops := strings.Split(lines[len(lines)-1], ",")
			if ip := strings.TrimSpace(hops[len(hops)-1]); ip != "" {
				return ip
			}
		}
	}
	host, _, err := net.SplitHostPort(r.RemoteAddr)
	if err != nil {
		return r.RemoteAddr
	}
	return host
}

func SetCookie(w http.ResponseWriter, cfg Config, name, value, path string, expires time.Time) {
	http.SetCookie(w, &http.Cookie{
		Name:     name,
		Value:    value,
		Path:     path,
		Expires:  expires,
		MaxAge:   max(1, int(time.Until(expires).Seconds())),
		HttpOnly: true,
		Secure:   cfg.CookieSecure,
		SameSite: http.SameSiteStrictMode,
	})
}

func ClearCookie(w http.ResponseWriter, cfg Config, name, path string) {
	http.SetCookie(w, &http.Cookie{
		Name:     name,
		Path:     path,
		MaxAge:   -1,
		HttpOnly: true,
		Secure:   cfg.CookieSecure,
		SameSite: http.SameSiteStrictMode,
	})
}
