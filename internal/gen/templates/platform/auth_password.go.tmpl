package auth

import (
	"crypto/pbkdf2"
	"crypto/rand"
	"crypto/sha256"
	"crypto/subtle"
	"encoding/base64"
	"fmt"
	"strconv"
	"strings"
	"sync"
)

const (
	passwordScheme     = "pbkdf2-sha256"
	PasswordIterations = 600000
	maxIterations      = 10000000
	saltBytes          = 16
	keyBytes           = 32
	MinPasswordLength  = {{.Auth.MinPassword}}
	MaxPasswordLength  = 1024
)

func HashPassword(password string) (string, error) {
	salt := make([]byte, saltBytes)
	rand.Read(salt)
	key, err := pbkdf2.Key(sha256.New, password, salt, PasswordIterations, keyBytes)
	if err != nil {
		return "", fmt.Errorf("auth: hash password: %w", err)
	}
	enc := base64.RawStdEncoding
	return passwordScheme + "$" + strconv.Itoa(PasswordIterations) + "$" + enc.EncodeToString(salt) + "$" + enc.EncodeToString(key), nil
}

func VerifyPassword(encoded, password string) (match bool, rehash bool) {
	parts := strings.Split(encoded, "$")
	if len(parts) != 4 || parts[0] != passwordScheme || len(password) > MaxPasswordLength*4 {
		return false, false
	}
	iterations, err := strconv.Atoi(parts[1])
	if err != nil || iterations < 1 || iterations > maxIterations {
		return false, false
	}
	enc := base64.RawStdEncoding
	salt, err := enc.DecodeString(parts[2])
	if err != nil || len(salt) < saltBytes {
		return false, false
	}
	want, err := enc.DecodeString(parts[3])
	if err != nil || len(want) != keyBytes {
		return false, false
	}
	got, err := pbkdf2.Key(sha256.New, password, salt, iterations, len(want))
	if err != nil {
		return false, false
	}
	match = subtle.ConstantTimeCompare(got, want) == 1
	return match, match && iterations < PasswordIterations
}

var decoy = sync.OnceValue(func() string {
	hash, _ := HashPassword("codebuild timing decoy")
	return hash
})

func RejectPassword(password string) {
	VerifyPassword(decoy(), password)
}
