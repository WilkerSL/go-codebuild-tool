{{.Header}}

package httpx

import (
	"context"
	"database/sql"
	"log/slog"
	"net/http"
	"sync/atomic"
	"time"
)

const (
	LivenessPath  = "/livez"
	ReadinessPath = "/readyz"
)

type Health struct {
{{- if not .Gateway}}
	db       *sql.DB
{{- end}}
	logger   *slog.Logger
	draining atomic.Bool
}
{{if .Gateway}}
func NewHealth(logger *slog.Logger) *Health {
	return &Health{logger: logger}
}
{{- else}}
func NewHealth(db *sql.DB, logger *slog.Logger) *Health {
	return &Health{db: db, logger: logger}
}
{{- end}}

func (h *Health) RegisterRoutes(mux *http.ServeMux) {
	mux.HandleFunc("GET "+LivenessPath, h.live)
	mux.HandleFunc("GET "+ReadinessPath, h.ready)
}

func (h *Health) Drain() {
	h.draining.Store(true)
}

func (h *Health) live(w http.ResponseWriter, _ *http.Request) {
	WriteJSON(w, http.StatusOK, map[string]string{"status": "ok"})
}

func (h *Health) ready(w http.ResponseWriter, r *http.Request) {
	if h.draining.Load() {
		WriteProblem(w, Problem{Status: http.StatusServiceUnavailable, Detail: "the server is shutting down", Instance: r.URL.Path})
		return
	}
{{- if not .Gateway}}
	ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
	defer cancel()
	if err := h.db.PingContext(ctx); err != nil {
		h.logger.WarnContext(r.Context(), "readiness check failed", slog.Any("error", err))
		WriteProblem(w, Problem{Status: http.StatusServiceUnavailable, Detail: "the database is not reachable", Instance: r.URL.Path})
		return
	}
{{- end}}
	WriteJSON(w, http.StatusOK, map[string]string{"status": "ready"})
}
