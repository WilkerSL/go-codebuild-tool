package database

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"io/fs"
	"slices"
	"strconv"
	"strings"
)

type Migration struct {
	Version uint64
	Name    string
	Up      string
	Down    string
}

func LoadMigrations(fsys fs.FS) ([]Migration, error) {
	entries, err := fs.ReadDir(fsys, ".")
	if err != nil {
		return nil, fmt.Errorf("database: read migrations: %w", err)
	}
	byVersion := map[uint64]*Migration{}
	ups := map[uint64]bool{}
	for _, entry := range entries {
		if entry.IsDir() {
			continue
		}
		prefix, rest, ok := strings.Cut(entry.Name(), "_")
		if !ok {
			continue
		}
		version, err := strconv.ParseUint(prefix, 10, 64)
		if err != nil || version == 0 {
			continue
		}
		name, up := strings.CutSuffix(rest, ".up.sql")
		if !up {
			var down bool
			if name, down = strings.CutSuffix(rest, ".down.sql"); !down {
				continue
			}
		}
		data, err := fs.ReadFile(fsys, entry.Name())
		if err != nil {
			return nil, fmt.Errorf("database: read migration %s: %w", entry.Name(), err)
		}
		m, ok := byVersion[version]
		if !ok {
			m = &Migration{Version: version, Name: name}
			byVersion[version] = m
		}
		if m.Name != name {
			return nil, fmt.Errorf("database: migrations %s_%s and %s_%s share version %d; renumber one of them", prefix, m.Name, prefix, name, version)
		}
		if up {
			m.Up, ups[version] = string(data), true
		} else {
			m.Down = string(data)
		}
	}
	migrations := make([]Migration, 0, len(byVersion))
	for _, m := range byVersion {
		if !ups[m.Version] {
			return nil, fmt.Errorf("database: migration %d_%s has a .down.sql file but no .up.sql file", m.Version, m.Name)
		}
		migrations = append(migrations, *m)
	}
	slices.SortFunc(migrations, func(a, b Migration) int {
		switch {
		case a.Version < b.Version:
			return -1
		case a.Version > b.Version:
			return 1
		}
		return 0
	})
	return migrations, nil
}

func MigrateUp(ctx context.Context, db *sql.DB, fsys fs.FS) ([]uint64, error) {
	migrations, err := LoadMigrations(fsys)
	if err != nil {
		return nil, err
	}
	conn, err := prepareMigrations(ctx, db)
	if err != nil {
		return nil, err
	}
	defer conn.Close()
	defer unlockMigrations(context.WithoutCancel(ctx), conn)
	if err := checkHistory(ctx, conn, migrations); err != nil {
		return nil, err
	}
	var applied []uint64
	for _, m := range migrations {
		current, dirty, err := readVersion(ctx, conn)
		if err != nil {
			return applied, err
		}
		if dirty {
			return applied, dirtyError(current)
		}
		if m.Version <= current {
			continue
		}
		err = applyMigration(ctx, conn, current, m.Version, m.Up, recordMigration(m))
		if errors.Is(err, errConcurrentMigration) {
			continue
		}
		if err != nil {
			return applied, fmt.Errorf("database: migration %d_%s: %w", m.Version, m.Name, err)
		}
		applied = append(applied, m.Version)
	}
	return applied, nil
}

func MigrateDown(ctx context.Context, db *sql.DB, fsys fs.FS, steps int) ([]uint64, error) {
	migrations, err := LoadMigrations(fsys)
	if err != nil {
		return nil, err
	}
	conn, err := prepareMigrations(ctx, db)
	if err != nil {
		return nil, err
	}
	defer conn.Close()
	defer unlockMigrations(context.WithoutCancel(ctx), conn)
	var reverted []uint64
	for range steps {
		current, dirty, err := readVersion(ctx, conn)
		if err != nil {
			return reverted, err
		}
		if dirty {
			return reverted, dirtyError(current)
		}
		if current == 0 {
			break
		}
		idx := slices.IndexFunc(migrations, func(m Migration) bool { return m.Version == current })
		if idx < 0 {
			return reverted, fmt.Errorf("database: migration %d is applied but its files are missing", current)
		}
		previous := uint64(0)
		if idx > 0 {
			previous = migrations[idx-1].Version
		}
		if err := applyMigration(ctx, conn, current, previous, migrations[idx].Down, forgetMigration(current)); err != nil && !errors.Is(err, errConcurrentMigration) {
			return reverted, fmt.Errorf("database: revert migration %d_%s: %w", current, migrations[idx].Name, err)
		}
		reverted = append(reverted, current)
	}
	return reverted, nil
}

func MigrationVersion(ctx context.Context, db *sql.DB) (uint64, bool, error) {
	conn, err := db.Conn(ctx)
	if err != nil {
		return 0, false, err
	}
	defer conn.Close()
	if err := ensureMigrationTable(ctx, conn); err != nil {
		return 0, false, fmt.Errorf("database: create schema_migrations: %w", err)
	}
	return readVersion(ctx, conn)
}

var errConcurrentMigration = errors.New("database: another process changed the schema version")

func prepareMigrations(ctx context.Context, db *sql.DB) (*sql.Conn, error) {
	conn, err := db.Conn(ctx)
	if err != nil {
		return nil, fmt.Errorf("database: acquire connection: %w", err)
	}
	if err := lockMigrations(ctx, conn); err != nil {
		conn.Close()
		return nil, fmt.Errorf("database: acquire migration lock: %w", err)
	}
	if err := ensureMigrationTable(ctx, conn); err != nil {
		unlockMigrations(context.WithoutCancel(ctx), conn)
		conn.Close()
		return nil, fmt.Errorf("database: create schema_migrations: %w", err)
	}
	return conn, nil
}

func readVersion(ctx context.Context, conn *sql.Conn) (uint64, bool, error) {
	var version int64
	var dirty bool
	err := conn.QueryRowContext(ctx, "SELECT version, dirty FROM schema_migrations").Scan(&version, &dirty)
	if errors.Is(err, sql.ErrNoRows) {
		return 0, false, nil
	}
	if err != nil {
		return 0, false, fmt.Errorf("database: read schema version: %w", err)
	}
	return uint64(version), dirty, nil
}

func dirtyError(version uint64) error {
	return fmt.Errorf("database: migration %d failed halfway and left the schema dirty; repair the database, then fix the row in schema_migrations", version)
}

type historyChange func(ctx context.Context, exec DBTX) error

func recordMigration(m Migration) historyChange {
	return func(ctx context.Context, exec DBTX) error {
		_, err := exec.ExecContext(ctx, historyInsertSQL, int64(m.Version), m.Name)
		return err
	}
}

func forgetMigration(version uint64) historyChange {
	return func(ctx context.Context, exec DBTX) error {
		_, err := exec.ExecContext(ctx, historyDeleteSQL, int64(version))
		return err
	}
}

func checkHistory(ctx context.Context, conn *sql.Conn, migrations []Migration) error {
	current, dirty, err := readVersion(ctx, conn)
	if err != nil {
		return err
	}
	if dirty {
		return dirtyError(current)
	}
	rows, err := conn.QueryContext(ctx, "SELECT version FROM schema_migrations_history")
	if err != nil {
		return fmt.Errorf("database: read migration history: %w", err)
	}
	applied := map[uint64]bool{}
	for rows.Next() {
		var version int64
		if err := rows.Scan(&version); err != nil {
			rows.Close()
			return fmt.Errorf("database: read migration history: %w", err)
		}
		applied[uint64(version)] = true
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return fmt.Errorf("database: read migration history: %w", err)
	}
	var skipped []string
	for _, m := range migrations {
		if m.Version > current || applied[m.Version] {
			continue
		}
		if len(applied) == 0 {
			if err := recordMigration(m)(ctx, conn); err != nil {
				return fmt.Errorf("database: record migration history: %w", err)
			}
			continue
		}
		skipped = append(skipped, fmt.Sprintf("%d_%s", m.Version, m.Name))
	}
	if len(skipped) > 0 {
		verb := "are"
		if len(skipped) == 1 {
			verb = "is"
		}
		return fmt.Errorf("database: %s %s older than the applied version %d but never ran, probably because it arrived in a merge; rename it to a version above %d and run migrate up again",
			strings.Join(skipped, ", "), verb, current, current)
	}
	return nil
}
{{- if .Dialect.Transactional}}

func applyInTransaction(ctx context.Context, conn *sql.Conn, version uint64, script string, history historyChange) error {
	tx, err := conn.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	defer tx.Rollback()
	for i, stmt := range splitStatements(script) {
		if _, err := tx.ExecContext(ctx, stmt); err != nil {
			return fmt.Errorf("statement %d: %w", i+1, err)
		}
	}
	if err := setVersion(ctx, tx, version, false); err != nil {
		return err
	}
	if err := history(ctx, tx); err != nil {
		return err
	}
	return tx.Commit()
}
{{- end}}

func splitStatements(script string) []string {
	var stmts []string
	var b strings.Builder
	hasCode := false
	var quote rune
	lineComment, blockComment := false, false
	runes := []rune(script)
	flush := func() {
		if hasCode {
			stmts = append(stmts, strings.TrimSpace(b.String()))
		}
		b.Reset()
		hasCode = false
	}
	for i := 0; i < len(runes); i++ {
		r := runes[i]
		var next rune
		if i+1 < len(runes) {
			next = runes[i+1]
		}
		switch {
		case lineComment:
			if r == '\n' {
				lineComment = false
			}
		case blockComment:
			if r == '*' && next == '/' {
				blockComment = false
				b.WriteRune(r)
				i++
				r = next
			}
		case quote != 0:
			if r == quote {
				quote = 0
			}
		case r == '-' && next == '-':
			lineComment = true
		case r == '/' && next == '*':
			blockComment = true
		case r == '\'' || r == '"' || r == '`':
			quote = r
			hasCode = true
		case r == '[':
			quote = ']'
			hasCode = true
		case r == ';':
			flush()
			continue
		case r != ' ' && r != '\t' && r != '\n' && r != '\r':
			hasCode = true
		}
		b.WriteRune(r)
	}
	flush()
	return stmts
}

