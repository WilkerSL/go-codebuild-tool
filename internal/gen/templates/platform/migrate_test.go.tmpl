func TestMigrateUpRejectsSkippedVersions(t *testing.T) {
	ctx := context.Background()
	db, err := Connect(filepath.Join(t.TempDir(), "migrate.db"))
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	first := fstest.MapFS{
		"0001_a.up.sql":   script("CREATE TABLE a (id INTEGER)"),
		"0001_a.down.sql": script("DROP TABLE a"),
		"0003_c.up.sql":   script("CREATE TABLE c (id INTEGER)"),
		"0003_c.down.sql": script("DROP TABLE c"),
	}
	if applied, err := MigrateUp(ctx, db, first); err != nil || !slices.Equal(applied, []uint64{1, 3}) {
		t.Fatalf("first run = %v %v", applied, err)
	}
	merged := maps.Clone(first)
	merged["0002_b.up.sql"] = script("CREATE TABLE b (id INTEGER)")
	merged["0002_b.down.sql"] = script("DROP TABLE b")
	if _, err := MigrateUp(ctx, db, merged); err == nil || !strings.Contains(err.Error(), "2_b") {
		t.Fatalf("a skipped migration was not reported: %v", err)
	}
	if _, err := db.ExecContext(ctx, "DELETE FROM schema_migrations_history"); err != nil {
		t.Fatal(err)
	}
	if _, err := MigrateUp(ctx, db, first); err != nil {
		t.Fatalf("a database migrated before the history existed: %v", err)
	}
	var recorded int
	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM schema_migrations_history").Scan(&recorded); err != nil || recorded != 2 {
		t.Fatalf("backfilled history = %d %v", recorded, err)
	}
	if reverted, err := MigrateDown(ctx, db, first, 2); err != nil || !slices.Equal(reverted, []uint64{3, 1}) {
		t.Fatalf("down = %v %v", reverted, err)
	}
	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM schema_migrations_history").Scan(&recorded); err != nil || recorded != 0 {
		t.Fatalf("history after down = %d %v", recorded, err)
	}
}
