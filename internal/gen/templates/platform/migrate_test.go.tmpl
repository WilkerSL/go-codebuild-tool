func script(sql string) *fstest.MapFile {
	return &fstest.MapFile{Data: []byte(sql)}
}

func TestLoadMigrationsRejectsDuplicates(t *testing.T) {
	_, err := LoadMigrations(fstest.MapFS{
		"0001_init.up.sql":  script("SELECT 1"),
		"0002_a.up.sql":     script("SELECT 1"),
		"0002_b.up.sql":     script("SELECT 1"),
		"0002_b.down.sql":   script("SELECT 1"),
		"0001_init.down.sql": script("SELECT 1"),
	})
	if err == nil || !strings.Contains(err.Error(), "share version 2") {
		t.Fatalf("duplicate versions = %v", err)
	}
	if _, err := LoadMigrations(fstest.MapFS{"0003_orphan.down.sql": script("SELECT 1")}); err == nil {
		t.Fatal("a down migration without an up migration was accepted")
	}
	migrations, err := LoadMigrations(fstest.MapFS{"0002_b.up.sql": script("B"), "0001_a.up.sql": script("A"), "notes.txt": script("x")})
	if err != nil || len(migrations) != 2 || migrations[0].Name != "a" || migrations[1].Up != "B" {
		t.Fatalf("migrations = %+v %v", migrations, err)
	}
}
