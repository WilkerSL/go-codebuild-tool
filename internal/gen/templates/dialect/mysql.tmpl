{{define "mysql.constraint" -}}
func Constraint(err error) (*ConstraintError, bool) {
	myErr, ok := errors.AsType[*mysql.MySQLError](err)
	if !ok {
		return nil, false
	}
	switch myErr.Number {
	case 1062:
		primary := strings.Contains(myErr.Message, ".PRIMARY'") || strings.Contains(myErr.Message, "'PRIMARY'")
		return &ConstraintError{Kind: UniqueViolation, Message: myErr.Message, PrimaryKey: primary, Err: err}, true
	case 1451, 1452:
		return &ConstraintError{Kind: ForeignKeyViolation, Message: myErr.Message, Err: err}, true
	case 1048, 1364:
		return &ConstraintError{Kind: NotNullViolation, Message: myErr.Message, Err: err}, true
	}
	return nil, false
}
{{- end}}


{{define "mysql.connect" -}}
{{.Header}}

package database

import (
	"database/sql"
	"fmt"
	"time"

	"github.com/go-sql-driver/mysql"
)

func Connect(dsn string) (*sql.DB, error) {
	cfg, err := mysql.ParseDSN(dsn)
	if err != nil {
		return nil, fmt.Errorf("parse database DSN: %w", err)
	}
	cfg.ParseTime = true
	cfg.Loc = time.UTC
	cfg.ClientFoundRows = true
	connector, err := mysql.NewConnector(cfg)
	if err != nil {
		return nil, fmt.Errorf("open database: %w", err)
	}
	return sql.OpenDB(connector), nil
}
{{- end}}

{{define "mysql.migrate" -}}
const (
	historyInsertSQL = "INSERT INTO schema_migrations_history (version, name) VALUES (?, ?)"
	historyDeleteSQL = "DELETE FROM schema_migrations_history WHERE version = ?"
)

func ensureMigrationTable(ctx context.Context, conn *sql.Conn) error {
	for _, stmt := range []string{
		"CREATE TABLE IF NOT EXISTS schema_migrations (version BIGINT NOT NULL PRIMARY KEY, dirty BOOLEAN NOT NULL)",
		"CREATE TABLE IF NOT EXISTS schema_migrations_history (version BIGINT NOT NULL PRIMARY KEY, name VARCHAR(255) NOT NULL)",
	} {
		if _, err := conn.ExecContext(ctx, stmt); err != nil {
			return err
		}
	}
	return nil
}

func lockMigrations(ctx context.Context, conn *sql.Conn) error {
	var acquired sql.NullInt64
	if err := conn.QueryRowContext(ctx, "SELECT GET_LOCK('codebuild_migrations', 60)").Scan(&acquired); err != nil {
		return err
	}
	if !acquired.Valid || acquired.Int64 != 1 {
		return errors.New("GET_LOCK timed out")
	}
	return nil
}

func unlockMigrations(ctx context.Context, conn *sql.Conn) error {
	_, err := conn.ExecContext(ctx, "SELECT RELEASE_LOCK('codebuild_migrations')")
	return err
}

func applyMigration(ctx context.Context, conn *sql.Conn, from, to uint64, script string, history historyChange) error {
	marker := to
	if marker == 0 {
		marker = from
	}
	if err := setVersion(ctx, conn, marker, true); err != nil {
		return err
	}
	for i, stmt := range splitStatements(script) {
		if _, err := conn.ExecContext(ctx, stmt); err != nil {
			return fmt.Errorf("statement %d: %w", i+1, err)
		}
	}
	if err := history(ctx, conn); err != nil {
		return err
	}
	return setVersion(ctx, conn, to, false)
}

func setVersion(ctx context.Context, exec DBTX, version uint64, dirty bool) error {
	if _, err := exec.ExecContext(ctx, "DELETE FROM schema_migrations"); err != nil {
		return err
	}
	if version == 0 {
		return nil
	}
	_, err := exec.ExecContext(ctx, "INSERT INTO schema_migrations (version, dirty) VALUES (?, ?)", int64(version), dirty)
	return err
}
