{{define "sqlserver.migrate" -}}
func ensureMigrationTable(ctx context.Context, conn *sql.Conn) error {
	_, err := conn.ExecContext(ctx, "IF OBJECT_ID(N'schema_migrations', N'U') IS NULL CREATE TABLE schema_migrations (version BIGINT NOT NULL PRIMARY KEY, dirty BIT NOT NULL)")
	return err
}

func lockMigrations(ctx context.Context, conn *sql.Conn) error {
	var result int
	err := conn.QueryRowContext(ctx, "DECLARE @result INT; EXEC @result = sp_getapplock @Resource = 'codebuild_migrations', @LockMode = 'Exclusive', @LockOwner = 'Session', @LockTimeout = 60000; SELECT @result").Scan(&result)
	if err != nil {
		return err
	}
	if result < 0 {
		return fmt.Errorf("sp_getapplock returned %d", result)
	}
	return nil
}

func unlockMigrations(ctx context.Context, conn *sql.Conn) error {
	_, err := conn.ExecContext(ctx, "EXEC sp_releaseapplock @Resource = 'codebuild_migrations', @LockOwner = 'Session'")
	return err
}

func applyMigration(ctx context.Context, conn *sql.Conn, _, to uint64, script string) error {
	return applyInTransaction(ctx, conn, to, script)
}

func setVersion(ctx context.Context, exec execer, version uint64, dirty bool) error {
	if _, err := exec.ExecContext(ctx, "DELETE FROM schema_migrations"); err != nil {
		return err
	}
	if version == 0 {
		return nil
	}
	_, err := exec.ExecContext(ctx, "INSERT INTO schema_migrations (version, dirty) VALUES (@p1, @p2)", int64(version), dirty)
	return err
}
