package auth

import (
	"context"
	"crypto/ed25519"
	"fmt"
	"log/slog"
	"net/http"
	"slices"
	"time"

	"{{.Module}}/internal/platform/grpcx"
	"{{.Module}}/internal/platform/httpx"
)

type Signer struct {
	key ed25519.PrivateKey
	now func() time.Time
}

func NewSigner(key ed25519.PrivateKey) *Signer {
	return &Signer{key: key, now: time.Now}
}

func (s *Signer) Sign(p Principal) (string, error) {
	now := s.now()
	return SignInternal(s.key, InternalClaims{
		Subject:    p.ID,
{{- if .Identity.Role}}
		Role:       p.Role,
{{- end}}
		Method:     string(p.Method),
		Credential: p.CredentialID,
		IssuedAt:   now.Unix(),
		ExpiresAt:  now.Add(InternalTokenTTL).Unix(),
	})
}

func Anonymous(signer *Signer, logger *slog.Logger, next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		token, err := signer.Sign(Principal{})
		if err != nil {
			httpx.WriteError(w, r, logger, err)
			return
		}
		next.ServeHTTP(w, r.WithContext(grpcx.WithToken(r.Context(), token)))
	})
}

type Authenticator func(ctx context.Context, token string) (Principal, error)

type Guard struct {
	authenticate Authenticator
	signer       *Signer
	origins      *http.CrossOriginProtection
	logger       *slog.Logger
}

func NewGuard(authenticate Authenticator, signer *Signer, cfg Config, logger *slog.Logger) (*Guard, error) {
	origins := http.NewCrossOriginProtection()
	for _, origin := range cfg.TrustedOrigins {
		if err := origins.AddTrustedOrigin(origin); err != nil {
			return nil, fmt.Errorf("auth: trusted origin: %w", err)
		}
	}
	return &Guard{authenticate: authenticate, signer: signer, origins: origins, logger: logger}, nil
}

func (g *Guard) Protect(next http.HandlerFunc, roles ...string) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		p, err := g.Authenticate(r)
		if err != nil {
			httpx.WriteError(w, r, g.logger, err)
			return
		}
{{- if .Auth.Role}}
		if len(roles) > 0 && !slices.Contains(roles, p.Role) {
			httpx.WriteError(w, r, g.logger, ErrForbidden)
			return
		}
{{- end}}
		token, err := g.signer.Sign(p)
		if err != nil {
			httpx.WriteError(w, r, g.logger, err)
			return
		}
		ctx := grpcx.WithToken(WithPrincipal(r.Context(), p), token)
		next(w, r.WithContext(ctx))
	})
}

func (g *Guard) Authenticate(r *http.Request) (Principal, error) {
	token, fromCookie := Credential(r)
	if token == "" {
		return Principal{}, ErrUnauthenticated
	}
	if fromCookie {
		if err := g.CheckOrigin(r); err != nil {
			return Principal{}, err
		}
	}
	if len(token) > maxTokenLength {
		return Principal{}, ErrInvalidToken
	}
	return g.authenticate(r.Context(), token)
}

func (g *Guard) CheckOrigin(r *http.Request) error {
	if err := g.origins.Check(r); err != nil {
		return httpx.NewError(http.StatusForbidden, "cross-origin requests cannot use the authentication cookie")
	}
	return nil
}
