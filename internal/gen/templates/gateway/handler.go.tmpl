type Handler struct {
	client {{.Proxy.Alias}}.{{.Proxy.Client}}
	logger *slog.Logger
}

func NewHandler(client {{.Proxy.Alias}}.{{.Proxy.Client}}, logger *slog.Logger) *Handler {
	return &Handler{client: client, logger: logger}
}

func (h *Handler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, grpcx.HTTPError(r.Context(), h.logger, err))
}

func (h *Handler) idempotent(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		key, err := httpx.IdempotencyKeyFrom(r)
		if err != nil {
			h.fail(w, r, err)
			return
		}
		if key != "" {
			r = r.WithContext(grpcx.WithIdempotencyKey(r.Context(), key))
		}
		next(w, r)
	}
}

func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
	p, err := listParams(r)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	page, err := h.client.List(r.Context(), p.message())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, fromPage(page))
}

