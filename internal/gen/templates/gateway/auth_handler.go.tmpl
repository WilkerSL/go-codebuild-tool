type apiKeyRequest struct {
	Name      *string `json:"name"`
	ExpiresAt *string `json:"expiresAt"`
}

func (req apiKeyRequest) message() (*{{.Proxy.Alias}}.APIKeyCreateRequest, error) {
	var errs validation.Errors
	m := &{{.Proxy.Alias}}.APIKeyCreateRequest{}
	switch {
	case req.Name == nil:
		errs.Add("name", "is required")
	case strings.TrimSpace(*req.Name) == "":
		errs.Add("name", "must not be empty")
	case utf8.RuneCountInString(*req.Name) > 120:
		errs.Add("name", "must be at most 120 characters")
	default:
		m.Name = *req.Name
	}
	m.ExpiresAt = grpcx.ParseTime(req.ExpiresAt, "expiresAt", &errs)
	return m, errs.Err()
}

type APIKey struct {
	ID        string     `json:"id"`
	Name      string     `json:"name"`
	Prefix    string     `json:"prefix"`
	CreatedAt time.Time  `json:"createdAt"`
	ExpiresAt *time.Time `json:"expiresAt"`
}

type CreatedAPIKey struct {
	ID        string     `json:"id"`
	Name      string     `json:"name"`
	Prefix    string     `json:"prefix"`
	CreatedAt time.Time  `json:"createdAt"`
	ExpiresAt *time.Time `json:"expiresAt"`
	Key       string     `json:"key"`
}

type apiKeyList struct {
	Items []APIKey `json:"items"`
}

func apiKeyFrom(k *{{.Proxy.Alias}}.APIKey) APIKey {
	return APIKey{ID: k.GetId(), Name: k.GetName(), Prefix: k.GetPrefix(), CreatedAt: k.GetCreatedAt().AsTime(), ExpiresAt: grpcx.NullTime(k.GetExpiresAt())}
}
{{- end}}

func tokensFrom(t *{{.Proxy.Alias}}.Tokens) auth.Tokens {
	return auth.Tokens{
		AccessToken: t.GetAccessToken(),
		TokenType:   t.GetTokenType(),
		ExpiresAt:   t.GetExpiresAt().AsTime(),
{{- if .Auth.JWT}}
		RefreshToken:     t.GetRefreshToken(),
		RefreshExpiresAt: t.GetRefreshExpiresAt().AsTime(),
{{- end}}
	}
}

type AuthHandler struct {
	client  {{.Proxy.Alias}}.AuthServiceClient
	guard   *auth.Guard
	cfg     auth.Config
	logger  *slog.Logger
	logins  *auth.Limiter
	clients *auth.Limiter
}

func NewAuthHandler(client {{.Proxy.Alias}}.AuthServiceClient, guard *auth.Guard, cfg auth.Config, logger *slog.Logger, store auth.LimitStore) *AuthHandler {
	clients := store
	if _, ok := store.(*auth.MemoryStore); ok {
		clients = auth.NewMemoryStore()
	}
	return &AuthHandler{
		client:  client,
		guard:   guard,
		cfg:     cfg,
		logger:  logger,
		logins:  auth.NewLimiter("login", cfg.LoginLimit, cfg.LoginWindow, store),
		clients: auth.NewLimiter("client", cfg.LoginLimit*10, cfg.LoginWindow, clients),
	}
}

func (h *AuthHandler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, grpcx.HTTPError(r.Context(), h.logger, err))
}

func (h *AuthHandler) resetLimit(r *http.Request, key string) {
	if err := h.logins.Reset(r.Context(), key); err != nil {
		h.logger.WarnContext(r.Context(), "rate limit reset failed", slog.Any("error", err))
	}
}

func (h *AuthHandler) writeTokens(w http.ResponseWriter, tokens auth.Tokens) {
	auth.SetCookie(w, h.cfg, auth.CredentialCookie, tokens.AccessToken, "/", tokens.ExpiresAt)
{{- if .Auth.JWT}}
	auth.SetCookie(w, h.cfg, auth.RefreshCookie, tokens.RefreshToken, "/auth", tokens.RefreshExpiresAt)
{{- end}}
	w.Header().Set("Cache-Control", "no-store")
	httpx.WriteJSON(w, http.StatusOK, tokens)
}
{{- if .Auth.Register}}

func (h *AuthHandler) register(w http.ResponseWriter, r *http.Request) {
	if err := h.clients.Allow(r.Context(), auth.ClientKey(r, h.cfg.TrustForwardedFor)); err != nil {
		h.fail(w, r, err)
		return
	}
	var req registerRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	msg, err := req.message()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	created, err := h.client.Register(r.Context(), msg)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item := fromMessage(created)
{{- if .Routes}}
	w.Header().Set("Location", "{{.Path}}/"+{{.Proxy.Location}})
{{- end}}
	httpx.WriteJSON(w, http.StatusCreated, item)
}
{{- end}}

func (h *AuthHandler) login(w http.ResponseWriter, r *http.Request) {
	var req loginRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	msg, err := req.message()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	client := auth.ClientKey(r, h.cfg.TrustForwardedFor)
	key := client + "|" + normalizeIdentity(msg.GetIdentity())
	if err := h.clients.Allow(r.Context(), client); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.logins.Allow(r.Context(), key); err != nil {
		h.fail(w, r, err)
		return
	}
	tokens, err := h.client.Login(r.Context(), msg)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.resetLimit(r, key)
	h.writeTokens(w, tokensFrom(tokens))
}
{{- if .Auth.JWT}}

func (h *AuthHandler) refresh(w http.ResponseWriter, r *http.Request) {
	token := ""
	if r.ContentLength != 0 {
		var req refreshRequest
		if err := httpx.DecodeJSON(w, r, &req); err != nil {
			h.fail(w, r, err)
			return
		}
		if req.RefreshToken != nil {
			token = *req.RefreshToken
		}
	}
	if token == "" {
		c, err := r.Cookie(auth.RefreshCookie)
		if err != nil || c.Value == "" {
			h.fail(w, r, auth.ErrUnauthenticated)
			return
		}
		if err := h.guard.CheckOrigin(r); err != nil {
			h.fail(w, r, err)
			return
		}
		token = c.Value
	}
	tokens, err := h.client.Refresh(r.Context(), &{{.Proxy.Alias}}.RefreshRequest{RefreshToken: token})
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.writeTokens(w, tokensFrom(tokens))
}
{{- end}}

func (h *AuthHandler) logout(w http.ResponseWriter, r *http.Request) {
	if _, err := h.client.Logout(r.Context(), &emptypb.Empty{}); err != nil {
		h.fail(w, r, err)
		return
	}
	auth.ClearCookie(w, h.cfg, auth.CredentialCookie, "/")
{{- if .Auth.JWT}}
	auth.ClearCookie(w, h.cfg, auth.RefreshCookie, "/auth")
{{- end}}
	w.WriteHeader(http.StatusNoContent)
}

func (h *AuthHandler) me(w http.ResponseWriter, r *http.Request) {
	item, err := h.client.Me(r.Context(), &emptypb.Empty{})
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, fromMessage(item))
}

func (h *AuthHandler) changePassword(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	var req passwordRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	msg, err := req.message()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	key := "password|" + caller.CredentialID
	if err := h.clients.Allow(r.Context(), auth.ClientKey(r, h.cfg.TrustForwardedFor)); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.logins.Allow(r.Context(), key); err != nil {
		h.fail(w, r, err)
		return
	}
	if _, err := h.client.ChangePassword(r.Context(), msg); err != nil {
		h.fail(w, r, err)
		return
	}
	h.resetLimit(r, key)
	w.WriteHeader(http.StatusNoContent)
}
{{- if .Auth.APIKey}}

func (h *AuthHandler) createAPIKey(w http.ResponseWriter, r *http.Request) {
	var req apiKeyRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	msg, err := req.message()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	k, err := h.client.CreateAPIKey(r.Context(), msg)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("Location", "/auth/api-keys/"+url.PathEscape(k.GetId()))
	httpx.WriteJSON(w, http.StatusCreated, CreatedAPIKey{ID: k.GetId(), Name: k.GetName(), Prefix: k.GetPrefix(), CreatedAt: k.GetCreatedAt().AsTime(), ExpiresAt: grpcx.NullTime(k.GetExpiresAt()), Key: k.GetKey()})
}

func (h *AuthHandler) listAPIKeys(w http.ResponseWriter, r *http.Request) {
	list, err := h.client.ListAPIKeys(r.Context(), &emptypb.Empty{})
	if err != nil {
		h.fail(w, r, err)
		return
	}
	items := make([]APIKey, len(list.GetItems()))
	for i, k := range list.GetItems() {
		items[i] = apiKeyFrom(k)
	}
	httpx.WriteJSON(w, http.StatusOK, apiKeyList{Items: items})
}

func (h *AuthHandler) deleteAPIKey(w http.ResponseWriter, r *http.Request) {
	id, err := httpx.PathString(r, "id")
	if err != nil {
		h.fail(w, r, err)
		return
	}
	if _, err := h.client.DeleteAPIKey(r.Context(), &{{.Proxy.Alias}}.APIKeyDeleteRequest{Id: id}); err != nil {
		h.fail(w, r, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
{{- end}}
