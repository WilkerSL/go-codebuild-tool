func Authenticator(client {{.Proxy.Alias}}.AuthServiceClient, logger *slog.Logger) auth.Authenticator {
	return func(ctx context.Context, token string) (auth.Principal, error) {
		p, err := client.Authenticate(ctx, &{{.Proxy.Alias}}.AuthenticateRequest{Token: token})
		if err != nil {
			return auth.Principal{}, grpcx.HTTPError(ctx, logger, err)
		}
		return auth.Principal{ID: p.GetId(), Role: p.GetRole(), Method: auth.Method(p.GetMethod()), CredentialID: p.GetCredentialId()}, nil
	}
}

type LimitStore struct {
	client {{.Proxy.Alias}}.AuthServiceClient
}

func NewLimitStore(client {{.Proxy.Alias}}.AuthServiceClient) *LimitStore {
	return &LimitStore{client: client}
}

func (s *LimitStore) Hit(ctx context.Context, key string, limit int, window time.Duration) (time.Duration, error) {
	res, err := s.client.HitRateLimit(ctx, &{{.Proxy.Alias}}.RateLimitRequest{Key: key, Limit: int32(min(limit, math.MaxInt32)), WindowMillis: window.Milliseconds()})
	if err != nil {
		return 0, err
	}
	return time.Duration(res.GetRetryAfterMillis()) * time.Millisecond, nil
}

func (s *LimitStore) Reset(ctx context.Context, key string) error {
	if _, err := s.client.ResetRateLimit(ctx, &{{.Proxy.Alias}}.RateLimitResetRequest{Key: key}); err != nil {
		return err
	}
	return nil
}

type loginRequest struct {
	Identity *string `json:"{{.Auth.Identity.InputJSON}}"`
	Password *string `json:"{{.Auth.Password.InputJSON}}"`
}

func (req loginRequest) message() (*{{.Proxy.Alias}}.LoginRequest, error) {
	var errs validation.Errors
	m := &{{.Proxy.Alias}}.LoginRequest{}
	if req.Identity == nil || *req.Identity == "" {
		errs.Add("{{.Auth.Identity.InputJSON}}", "is required")
	} else if utf8.RuneCountInString(*req.Identity) > {{.Auth.IdentityMax}} {
		errs.Add("{{.Auth.Identity.InputJSON}}", "must be at most {{.Auth.IdentityMax}} characters")
	} else {
		m.Identity = *req.Identity
	}
	if req.Password == nil || *req.Password == "" {
		errs.Add("{{.Auth.Password.InputJSON}}", "is required")
	} else {
		m.Password = *req.Password
	}
	return m, errs.Err()
}

func normalizeIdentity(identity string) string {
{{- if .Auth.EmailIdentity}}
	return strings.ToLower(identity)
{{- else}}
	return identity
{{- end}}
}

type passwordRequest struct {
	CurrentPassword *string `json:"currentPassword"`
	NewPassword     *string `json:"newPassword"`
}

func (req passwordRequest) message() (*{{.Proxy.Alias}}.ChangePasswordRequest, error) {
	var errs validation.Errors
	m := &{{.Proxy.Alias}}.ChangePasswordRequest{}
	if req.CurrentPassword == nil {
		errs.Add("currentPassword", "is required")
	} else {
		m.CurrentPassword = *req.CurrentPassword
	}
	if req.NewPassword == nil {
		errs.Add("newPassword", "is required")
	} else {
		m.NewPassword = *req.NewPassword
	}
	return m, errs.Err()
}
