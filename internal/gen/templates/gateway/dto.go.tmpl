type {{.Name}} struct {
{{- range .Proxy.Fields}}
	{{.Name}} {{.Type}} `json:"{{.JSON}}"`
{{- end}}
}

type Page struct {
	Items  []{{.Name}} `json:"items"`
	Limit  int `json:"limit"`
	Offset int `json:"offset"`
	Total  int64 `json:"total"`
}

func fromMessage(m *{{.Proxy.Alias}}.{{.Name}}) {{.Name}} {
	return {{.Name}}{
{{- range .Proxy.Fields}}
		{{.Name}}: {{.From}},
{{- end}}
	}
}

func fromPage(m *{{.Proxy.Alias}}.{{.Name}}Page) Page {
	items := make([]{{.Name}}, len(m.GetItems()))
	for i, item := range m.GetItems() {
		items[i] = fromMessage(item)
	}
	return Page{Items: items, Limit: int(m.GetLimit()), Offset: int(m.GetOffset()), Total: m.GetTotal()}
}

type ListParams struct {
	Limit  int
	Offset int
{{- range .Filters}}
	{{.Name}} {{.FilterType}}
{{- end}}
}

func listParams(r *http.Request) (ListParams, error) {
	q := r.URL.Query()
	var errs validation.Errors
	var p ListParams
	p.Limit, p.Offset = httpx.Pagination(q, &errs)
{{- range .Filters}}
	{{.FilterParse}}
{{- end}}
	if len(errs) > 0 {
		return ListParams{}, httpx.BadRequest("the query string contains invalid parameters", errs...)
	}
	return p, nil
}

func (p ListParams) message() *{{.Proxy.Alias}}.{{.Name}}ListRequest {
	return &{{.Proxy.Alias}}.{{.Name}}ListRequest{
		Limit:  int32(p.Limit),
		Offset: int32(p.Offset),
{{- range .Proxy.Filters}}
		{{.Name}}: {{.From}},
{{- end}}
	}
}
{{- range .Proxy.Relations}}

func (p ListParams) {{.ParamsFunc}}({{.SourceIDVar}} {{.SourceIDType}}) *{{$.Proxy.Alias}}.{{.Method}}Request {
	return &{{$.Proxy.Alias}}.{{.Method}}Request{
		SourceId: {{.SourceProto}},
		Limit:    int32(p.Limit),
		Offset:   int32(p.Offset),
{{- range .Filters}}
		{{.Name}}: {{.From}},
{{- end}}
	}
}
{{- end}}
