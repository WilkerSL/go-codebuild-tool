const (
	TokenHeader     = "x-internal-token"
	RequestIDHeader = "x-request-id"
	CallTimeout     = 10 * time.Second
	maxRetryBackoff = time.Second
	DefaultMaxMessageBytes = 4 << 20
)

const (
	IdempotencyKeyHeader = "idempotency-key"
	ReplayedHeader       = "idempotent-replayed"
)

type idempotencyKey struct{}

func WithIdempotencyKey(ctx context.Context, key string) context.Context {
	return context.WithValue(ctx, idempotencyKey{}, key)
}

func Replayed(header metadata.MD) bool {
	return len(header.Get(ReplayedHeader)) > 0
}

type tokenKey struct{}

func WithToken(ctx context.Context, token string) context.Context {
	return context.WithValue(ctx, tokenKey{}, token)
}

func TokenFrom(ctx context.Context) string {
	token, _ := ctx.Value(tokenKey{}).(string)
	return token
}

type CallPolicy struct {
	Timeout         time.Duration
	RetryAttempts   int
	RetryBackoff    time.Duration
	BreakerFailures int
	BreakerCooldown time.Duration
	MaxMessageBytes int
}

func LoadCallPolicy(getenv func(string) string) (CallPolicy, error) {
	var errs []error
	duration := func(key string, fallback time.Duration) time.Duration {
		v := getenv(key)
		if v == "" {
			return fallback
		}
		d, err := time.ParseDuration(v)
		if err != nil || d <= 0 {
			errs = append(errs, fmt.Errorf("%s must be a positive duration such as 100ms, got %q", key, v))
			return fallback
		}
		return d
	}
	count := func(key string, fallback, least int) int {
		v := getenv(key)
		if v == "" {
			return fallback
		}
		n, err := strconv.Atoi(v)
		if err != nil || n < least || n > 100 {
			errs = append(errs, fmt.Errorf("%s must be an integer between %d and 100, got %q", key, least, v))
			return fallback
		}
		return n
	}
	p := CallPolicy{
		Timeout:         duration("GRPC_CALL_TIMEOUT", CallTimeout),
		RetryAttempts:   count("GRPC_RETRY_ATTEMPTS", 3, 1),
		RetryBackoff:    duration("GRPC_RETRY_BACKOFF", 50*time.Millisecond),
		BreakerFailures: count("GRPC_BREAKER_FAILURES", 5, 0),
		BreakerCooldown: duration("GRPC_BREAKER_COOLDOWN", 10*time.Second),
		MaxMessageBytes: DefaultMaxMessageBytes,
	}
	if v := getenv("GRPC_MAX_MESSAGE_BYTES"); v != "" {
		n, err := strconv.Atoi(v)
		if err != nil || n < 1<<20 || n > 1<<30 {
			errs = append(errs, fmt.Errorf("GRPC_MAX_MESSAGE_BYTES must be an integer between 1048576 (1 MiB) and 1073741824 (1 GiB), got %q", v))
		} else {
			p.MaxMessageBytes = n
		}
	}
	return p, errors.Join(errs...)
}

const serviceConfig = `{"loadBalancingConfig":[{"round_robin":{}}],"healthCheckConfig":{"serviceName":""}}`

