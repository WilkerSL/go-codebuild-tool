const (
	InternalTokenTTL = time.Minute
	internalSkew     = 5 * time.Second
)

type InternalClaims struct {
	Subject    string `json:"sub,omitempty"`
{{- if .Identity.Role}}
	Role       string `json:"role,omitempty"`
{{- end}}
	Method     string `json:"mth,omitempty"`
	Credential string `json:"cid,omitempty"`
	IssuedAt   int64  `json:"iat"`
	ExpiresAt  int64  `json:"exp"`
}

var internalHeader = base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"EdDSA","typ":"JWT"}`))

var errInternalToken = errors.New("auth: invalid internal token")

func SignInternal(key ed25519.PrivateKey, c InternalClaims) (string, error) {
	payload, err := json.Marshal(c)
	if err != nil {
		return "", fmt.Errorf("auth: encode internal claims: %w", err)
	}
	signed := internalHeader + "." + base64.RawURLEncoding.EncodeToString(payload)
	return signed + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(key, []byte(signed))), nil
}

type Verifier struct {
	key ed25519.PublicKey
	now func() time.Time
}

func NewVerifier(key ed25519.PublicKey) *Verifier {
	return &Verifier{key: key, now: time.Now}
}

func (v *Verifier) Claims(token string) (InternalClaims, error) {
	header, rest, ok := strings.Cut(token, ".")
	if !ok || header != internalHeader {
		return InternalClaims{}, errInternalToken
	}
	payload, signature, ok := strings.Cut(rest, ".")
	if !ok || strings.Contains(signature, ".") {
		return InternalClaims{}, errInternalToken
	}
	sig, err := base64.RawURLEncoding.DecodeString(signature)
	if err != nil || !ed25519.Verify(v.key, []byte(header+"."+payload), sig) {
		return InternalClaims{}, errInternalToken
	}
	data, err := base64.RawURLEncoding.DecodeString(payload)
	if err != nil {
		return InternalClaims{}, errInternalToken
	}
	var c InternalClaims
	if err := json.Unmarshal(data, &c); err != nil {
		return InternalClaims{}, errInternalToken
	}
	now := v.now()
	if now.Unix() > c.ExpiresAt+int64(internalSkew.Seconds()) || c.IssuedAt > now.Add(internalSkew).Unix() {
		return InternalClaims{}, errInternalToken
	}
	return c, nil
}

func (v *Verifier) Verify(token string) (Principal, bool, error) {
	c, err := v.Claims(token)
	if err != nil {
		return Principal{}, false, err
	}
	if c.Subject == "" {
		return Principal{}, false, nil
	}
	id, err := ParseID(c.Subject)
	if err != nil {
		return Principal{}, false, errInternalToken
	}
	return Principal{ID: id{{if .Identity.Role}}, Role: c.Role{{end}}, Method: Method(c.Method), CredentialID: c.Credential}, true, nil
}

