{{.Header}}

package app

import (
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"os"

	"google.golang.org/grpc"
{{range .Current.Imports}}
	{{.Name}} "{{.Path}}"
{{- end}}
{{- range .Domains}}
	"{{.Import}}"
{{- end}}
	"{{.Module}}/internal/platform/auth"
	"{{.Module}}/internal/platform/grpcx"
)

type Peers struct {
{{- range .Current.Peers}}
	{{.Field}} *grpc.ClientConn
{{- end}}
	conns []*grpc.ClientConn
}

func DialPeers(getenv func(string) string, cfg grpcx.TLSConfig) (*Peers, error) {
	p := &Peers{}
{{- if .Current.Peers}}
	policy, err := grpcx.LoadCallPolicy(getenv)
	if err != nil {
		return nil, err
	}
{{- end}}
{{- range .Current.Peers}}
	if p.{{.Field}}, err = p.dial(getenv, "{{.Env}}", cfg, policy); err != nil {
		p.Close()
		return nil, err
	}
{{- end}}
	return p, nil
}

func (p *Peers) dial(getenv func(string) string, key string, cfg grpcx.TLSConfig, policy grpcx.CallPolicy) (*grpc.ClientConn, error) {
	addr := getenv(key)
	if addr == "" {
		return nil, fmt.Errorf("%s is required: the host:port of the peer service", key)
	}
	conn, err := grpcx.Dial(addr, cfg, policy)
	if err != nil {
		return nil, err
	}
	p.conns = append(p.conns, conn)
	return conn, nil
}

func (p *Peers) Close() error {
	var errs []error
	for _, conn := range p.conns {
		errs = append(errs, conn.Close())
	}
	return errors.Join(errs...)
}

func Register(server *grpc.Server, db *sql.DB, peers *Peers, logger *slog.Logger) error {
{{- if .Auth}}
	cfg, err := auth.LoadConfig(os.Getenv)
	if err != nil {
		return err
	}
	accounts := {{.Auth.Package}}.NewAccounts(db, cfg)
	{{.Current.Alias}}.RegisterAuthServiceServer(server, {{.Auth.Package}}.NewAuthGRPCServer({{.Auth.Package}}.NewAuthService(db, accounts), accounts, {{.Auth.Package}}.NewLimitStore(db), logger))
{{- end}}
{{- range .Domains}}
	{{.GRPC.Alias}}.Register{{.GRPC.Service}}Server(server, {{.Package}}.NewGRPCServer({{.Package}}.NewService(db), logger{{range .GRPC.Peers}}, {{.Alias}}.New{{.Type}}(peers.{{.Service}}){{end}}))
{{- end}}
	return nil
}
