{{.YAMLHeader}}

name: {{.Project}}

services:
  certs:
    build:
      context: .
      dockerfile: gateway/Dockerfile
    image: {{.Project}}-gateway
    entrypoint: ["/app/devcerts", "-out", "/certs", "-hosts", "localhost,127.0.0.1"]
    volumes:
      - certs:/certs
{{- if .SQLServer}}

  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: {{.SQLServerPassword}}
    volumes:
      - sqlserver-data:/var/opt/mssql
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P {{.SQLServerPassword}} -C -Q 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 30

  sqlserver-init:
    image: mcr.microsoft.com/mssql/server:2022-latest
    entrypoint:
      - /opt/mssql-tools18/bin/sqlcmd
      - -S
      - sqlserver
      - -U
      - sa
      - -P
      - {{.SQLServerPassword}}
      - -C
      - -Q
      - "{{range .Databases}}IF DB_ID('{{.Name}}') IS NULL CREATE DATABASE [{{.Name}}]; {{end}}"
    depends_on:
      sqlserver:
        condition: service_healthy
{{- else if eq .Dialect.Name "postgres"}}
{{- range .Databases}}

  {{.Host}}:
    image: postgres:17
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: {{.Name}}
    volumes:
      - {{.Volume}}:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d {{.Name}}"]
      interval: 5s
      timeout: 5s
      retries: 30
{{- end}}
{{- else if eq .Dialect.Name "mysql"}}
{{- range .Databases}}

  {{.Host}}:
    image: mysql:8.4
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: {{.Name}}
      MYSQL_USER: app
      MYSQL_PASSWORD: app
    volumes:
      - {{.Volume}}:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -proot"]
      interval: 5s
      timeout: 5s
      retries: 30
{{- end}}
{{- end}}
{{- range .Jobs}}

  {{.Name}}:
    build:
      context: .
      dockerfile: {{.Dir}}/Dockerfile
    image: {{.Image}}
    entrypoint: ["/app/migrate", "up"]
    environment:
{{- range .Env}}
      {{index . 0}}: "{{index . 1}}"
{{- end}}
{{- if .Data}}
    volumes:
      - {{.Database.Volume}}:/data
{{- end}}
{{- if .DependsOn}}
    depends_on:
{{- range .DependsOn}}
      {{index . 0}}:
        condition: {{index . 1}}
{{- end}}
{{- end}}
{{- end}}
{{- range .Modules}}

  {{.Name}}:
    build:
      context: .
      dockerfile: {{.Dir}}/Dockerfile
    image: {{.Image}}
{{- if .Expose}}
    ports:
      - "{{.Expose}}"
{{- end}}
    environment:
{{- range .Env}}
      {{index . 0}}: "{{index . 1}}"
{{- end}}
    volumes:
      - certs:/certs:ro
{{- if and .Data .Database}}
      - {{.Database.Volume}}:/data
{{- end}}
    healthcheck:
      test: ["CMD", "{{.Health}}", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 30
    depends_on:
{{- range .DependsOn}}
      {{index . 0}}:
        condition: {{index . 1}}
{{- end}}
{{- end}}
{{- with .Observability}}

  jaeger:
    image: {{.JaegerImage}}
    profiles: [observability]
    command: ["--config", "/etc/jaeger/config.yaml"]
    volumes:
      - ./deploy/observability/jaeger.yaml:/etc/jaeger/config.yaml:ro
      - ./deploy/observability/jaeger-ui.json:/etc/jaeger/ui.json:ro
{{- if not .Ops}}
    ports:
      - "127.0.0.1:16686:16686"
{{- end}}

  prometheus:
    image: {{.PrometheusImage}}
    profiles: [observability]
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=7d
      - --web.external-url=/_ops/prometheus/
    volumes:
      - ./deploy/observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./deploy/observability/alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus-data:/prometheus
{{- if not .Ops}}
    ports:
      - "127.0.0.1:9091:9090"
{{- end}}

  grafana:
    image: {{.GrafanaImage}}
    profiles: [observability]
    environment:
      GF_SERVER_ROOT_URL: "%(protocol)s://%(domain)s:%(http_port)s/_ops/grafana/"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_AUTH_BASIC_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_LIVE_MAX_CONNECTIONS: "0"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
{{- if .Ops}}
      GF_AUTH_PROXY_ENABLED: "true"
      GF_AUTH_PROXY_HEADER_NAME: X-WEBAUTH-USER
      GF_AUTH_PROXY_HEADER_PROPERTY: username
      GF_AUTH_PROXY_AUTO_SIGN_UP: "true"
      GF_AUTH_DISABLE_SIGNOUT_MENU: "true"
      GF_USERS_AUTO_ASSIGN_ORG_ROLE: Editor
{{- else}}
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
{{- end}}
    volumes:
      - ./deploy/observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./deploy/observability/grafana/dashboards:/etc/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana
{{- if not .Ops}}
    ports:
      - "127.0.0.1:3000:3000"
{{- end}}
{{- end}}

volumes:
  certs:
{{- if .Observability}}
  prometheus-data:
  grafana-data:
{{- end}}
{{- if .SQLServer}}
  sqlserver-data:
{{- else}}
{{- range .Databases}}
  {{.Volume}}:
{{- end}}
{{- end}}
