FROM golang:{{.GoImage}} AS build
WORKDIR /src
ENV GOWORK=off CGO_ENABLED=0
COPY {{.Dir}}/go.mod {{.Dir}}/go.sum {{.Dir}}/
{{- range .Locals}}
COPY {{.}}/go.mod {{.}}/
{{- end}}
RUN cd {{.Dir}} && go mod download
{{- range .Locals}}
COPY {{.}}/ {{.}}/
{{- end}}
COPY {{.Dir}}/ {{.Dir}}/
RUN cd {{.Dir}}{{range .Binaries}} \
 && go build -trimpath -ldflags="-s -w" -o /out/bin/{{.Name}} {{.Package}}{{end}}
RUN mkdir -p /out/data /out/certs

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/bin/ /app/
{{- if .Certs}}
COPY --from=build --chown=nonroot:nonroot /out/certs /certs
{{- end}}
{{- if .Data}}
COPY --from=build --chown=nonroot:nonroot /out/data /data
VOLUME ["/data"]
{{- end}}
{{- if eq .Kind "service"}}
ENV GRPC_ADDR=:9000 HEALTH_ADDR=:8081
EXPOSE 9000
{{- else if eq .Kind "gateway"}}
ENV HTTP_ADDR=:8080
EXPOSE 8080
{{- end}}
USER nonroot:nonroot
ENTRYPOINT ["{{.Entrypoint}}"]
{{- if .Command}}
CMD ["{{.Command}}"]
{{- end}}
