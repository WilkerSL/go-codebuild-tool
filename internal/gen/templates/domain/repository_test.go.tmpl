func TestRepositoryCursor(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	repo := {{.Package}}.NewRepository(db)
{{- if .Owned}}
	{{.TestOwner}}
{{- end}}
	want := map[{{.PK.BaseType}}]bool{}
	for range 3 {
		want[{{.OwnHelper}}(t, ctx, db{{.TestOwnerSuffix}}).{{.PK.Name}}] = true
	}
	first, err := repo.List(ctx, {{.TestOwnerArg}}{{.Package}}.ListParams{Limit: 1})
	if err != nil || first.Total == nil || first.NextCursor == nil {
		t.Fatalf("an offset page with more rows has no cursor: %+v %v", first, err)
	}
	seen := map[{{.PK.BaseType}}]bool{}
	p := {{.Package}}.ListParams{Limit: 2}
	for pages := 0; ; pages++ {
		if pages > 10000 {
			t.Fatal("cursor pagination does not end")
		}
		page, err := repo.List(ctx, {{.TestOwnerArg}}p)
		if err != nil {
			t.Fatalf("list: %v", err)
		}
		if p.Cursor != nil && page.Total != nil {
			t.Fatal("a cursor page counted the rows")
		}
		for _, item := range page.Items {
			if seen[item.{{.PK.Name}}] {
				t.Fatalf("%v appeared on two pages", item.{{.PK.Name}})
			}
			seen[item.{{.PK.Name}}] = true
		}
		if page.NextCursor == nil {
			break
		}
		cursor, err := {{.Package}}.ParseCursor(*page.NextCursor)
		if err != nil {
			t.Fatalf("parse cursor %q: %v", *page.NextCursor, err)
		}
		p.Cursor = &cursor
	}
	for id := range want {
		if !seen[id] {
			t.Fatalf("cursor pagination skipped %v", id)
		}
	}
	for _, bad := range []string{"", "not a cursor", "e30"} {
		if _, err := {{.Package}}.ParseCursor(bad); !errors.Is(err, {{.Package}}.ErrInvalidCursor) {
			t.Errorf("ParseCursor(%q) = %v", bad, err)
		}
	}
}
{{- end}}

