func TestRepositoryUniqueConflict(t *testing.T) {
	db := openTestDB(t)
	ctx := context.Background()
	first := {{.OwnHelper}}(t, ctx, db)
	in := {{.OwnInputHelper}}(t, ctx, db)
	in.{{.UniqueTestField.Name}} = first.{{.UniqueTestField.Name}}
	_, err := {{.Package}}.NewRepository(db).Create(ctx, in)
	ce, ok := errors.AsType[*database.ConstraintError](err)
	if !ok || ce.Kind != database.UniqueViolation || ce.Field != "{{.UniqueTestField.JSON}}" {
		t.Fatalf("expected a unique violation on {{.UniqueTestField.JSON}}, got %v", err)
	}
}
{{- end}}
