func TestRepositoryWithTx(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	repo := {{.Package}}.NewRepository(db)
{{- if .Owned}}
	{{.TestOwner}}
{{- end}}
	in := {{.OwnInputHelper}}(t, ctx, db)
	tx, err := db.BeginTx(ctx, nil)
	if err != nil {
		t.Fatalf("begin: %v", err)
	}
	created, err := repo.WithTx(tx).Create(ctx, {{.TestOwnerArg}}in)
	if err != nil {
		tx.Rollback()
		t.Fatalf("create in transaction: %v", err)
	}
	if _, err := repo.WithTx(tx).Get(ctx, {{.TestOwnerArg}}created.{{.PK.Name}}); err != nil {
		tx.Rollback()
		t.Fatalf("get in transaction: %v", err)
	}
	if err := tx.Rollback(); err != nil {
		t.Fatalf("rollback: %v", err)
	}
	if _, err := repo.Get(ctx, {{.TestOwnerArg}}created.{{.PK.Name}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("rolled back row is visible: %v", err)
	}
	next := {{.OwnInputHelper}}(t, ctx, db)
	var committed {{.Package}}.{{.Name}}
	err = database.InTx(ctx, db, func(tx *sql.Tx) error {
		var err error
		committed, err = repo.WithTx(tx).Create(ctx, {{.TestOwnerArg}}next)
		return err
	})
	if err != nil {
		t.Fatalf("InTx: %v", err)
	}
	if _, err := repo.Get(ctx, {{.TestOwnerArg}}committed.{{.PK.Name}}); err != nil {
		t.Fatalf("committed row is missing: %v", err)
	}
}
{{- end}}
