func openTestDB(t *testing.T) *sql.DB {
	t.Helper()
	dsn := os.Getenv("TEST_DATABASE_URL")
	if dsn == "" {
{{- if .Dialect.Embedded}}
		dsn = filepath.Join(t.TempDir(), "test.db")
{{- else}}
		t.Skip("TEST_DATABASE_URL is not set; point it at a disposable {{.Dialect.Name}} database to run repository tests")
{{- end}}
	}
	db, err := database.Connect(dsn)
	if err != nil {
		t.Fatalf("connect: %v", err)
	}
	t.Cleanup(func() { db.Close() })
	if _, err := database.MigrateUp(context.Background(), db, migrations.FS); err != nil {
		t.Fatalf("migrate: %v", err)
	}
	return db
}

func testString(n int) string {
	b := make([]byte, (n+1)/2)
	rand.Read(b)
	return hex.EncodeToString(b)[:n]
}

func testEmail(limit int) string {
	domain := "@example.com"
	if limit < len(domain)+4 {
		domain = "@x.io"
	}
	return testString(max(1, min(16, limit-len(domain)))) + domain
}

func testInt[T int16 | int32 | int | int64](lo, hi int64) T {
	return T(lo + mrand.Int64N(hi-lo+1))
}
