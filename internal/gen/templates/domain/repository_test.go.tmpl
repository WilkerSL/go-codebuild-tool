func TestRepositoryCRUD(t *testing.T) {
	db := openTestDB(t)
	ctx := context.Background()
	repo := {{.Package}}.NewRepository(db)
{{- if .Creatable}}
	created := {{.OwnHelper}}(t, ctx, db)
	got, err := repo.Get(ctx, created.{{.PK.Name}})
	if err != nil {
		t.Fatalf("get: %v", err)
	}
	if got.{{.PK.Name}} != created.{{.PK.Name}} {
		t.Fatalf("get returned %v, want %v", got.{{.PK.Name}}, created.{{.PK.Name}})
	}
	if ok, err := repo.Exists(ctx, created.{{.PK.Name}}); err != nil || !ok {
		t.Fatalf("exists: %v %v", ok, err)
	}
	page, err := repo.List(ctx, {{.Package}}.ListParams{Limit: 10{{if .ListFilterField}}, {{.ListFilterField.Name}}: &created.{{.ListFilterField.Name}}{{end}}})
	if err != nil {
		t.Fatalf("list: %v", err)
	}
{{- if .ListFilterField}}
	if page.Total != 1 || len(page.Items) != 1 || page.Items[0].{{.PK.Name}} != created.{{.PK.Name}} {
		t.Fatalf("filtered list returned %d of %d items", len(page.Items), page.Total)
	}
{{- else}}
	if page.Total < 1 || len(page.Items) < 1 {
		t.Fatalf("list returned %d of %d items", len(page.Items), page.Total)
	}
{{- end}}
{{- if .HasUpdate}}
	updated, err := repo.Update(ctx, created.{{.PK.Name}}, {{.Package}}.UpdateInput{
{{- range .UpdateTestValues}}
		{{.}}
{{- end}}
	})
	if err != nil {
		t.Fatalf("update: %v", err)
	}
	if updated.{{.PK.Name}} != created.{{.PK.Name}} {
		t.Fatalf("update returned %v, want %v", updated.{{.PK.Name}}, created.{{.PK.Name}})
	}
	if _, err := repo.Update(ctx, {{.MissingID}}, {{.Package}}.UpdateInput{
{{- range .UpdateTestValues}}
		{{.}}
{{- end}}
	}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("update missing: %v", err)
	}
{{- end}}
	if err := repo.Delete(ctx, created.{{.PK.Name}}); err != nil {
		t.Fatalf("delete: %v", err)
	}
	if _, err := repo.Get(ctx, created.{{.PK.Name}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("get after delete: %v", err)
	}
	if err := repo.Delete(ctx, created.{{.PK.Name}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("second delete: %v", err)
	}
{{- else}}
	if _, err := repo.List(ctx, {{.Package}}.ListParams{Limit: 10}); err != nil {
		t.Fatalf("list: %v", err)
	}
{{- end}}
	if _, err := repo.Get(ctx, {{.MissingID}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("get missing: %v", err)
	}
}
