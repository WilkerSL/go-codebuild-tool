func TestRepository{{.Method}}(t *testing.T) {
	db := openTestDB(t)
	ctx := context.Background()
	repo := {{$.Package}}.NewRepository(db)
{{- if .TestLink}}
	source := {{.SourceHelper}}(t, ctx, db)
	target := {{$.OwnHelper}}(t, ctx, db)
	for range 2 {
		if err := repo.{{.LinkMethod}}(ctx, source.{{.Source.PK.Name}}, target.{{$.PK.Name}}); err != nil {
			t.Fatalf("link: %v", err)
		}
	}
	page, err := repo.{{.Method}}(ctx, source.{{.Source.PK.Name}}, {{$.Package}}.ListParams{Limit: 10})
	if err != nil {
		t.Fatalf("list: %v", err)
	}
	if page.Total != 1 || len(page.Items) != 1 || page.Items[0].{{$.PK.Name}} != target.{{$.PK.Name}} {
		t.Fatalf("list returned %d of %d items", len(page.Items), page.Total)
	}
	if err := repo.{{.UnlinkMethod}}(ctx, source.{{.Source.PK.Name}}, target.{{$.PK.Name}}); err != nil {
		t.Fatalf("unlink: %v", err)
	}
	page, err = repo.{{.Method}}(ctx, source.{{.Source.PK.Name}}, {{$.Package}}.ListParams{Limit: 10})
	if err != nil || page.Total != 0 {
		t.Fatalf("list after unlink: %d items, %v", page.Total, err)
	}
	if err := repo.{{.LinkMethod}}(ctx, source.{{.Source.PK.Name}}, {{$.MissingID}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("link a missing record: %v", err)
	}
{{- end}}
	if _, err := repo.{{.Method}}(ctx, {{.MissingSourceID}}, {{$.Package}}.ListParams{Limit: 10}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("list for a missing source: %v", err)
	}
}
{{- end}}
