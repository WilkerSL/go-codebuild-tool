func TestAccountsAPIKeys(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	user := {{.OwnHelper}}(t, ctx, db)
	tokens, _ := accounts.Issue(ctx, user)
	caller, err := accounts.Authenticate(ctx, tokens.AccessToken)
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}
	created, err := accounts.CreateAPIKey(ctx, caller, {{.Package}}.APIKeyInput{Name: "ci"})
	if err != nil || !strings.HasPrefix(created.Key, auth.APIKeyPrefix) || !strings.HasPrefix(created.Key, created.Prefix) {
		t.Fatalf("create API key = %+v %v", created, err)
	}
	keyCaller, err := accounts.Authenticate(ctx, created.Key)
	if err != nil || keyCaller.ID != user.{{.PK.Name}} || keyCaller.Method != auth.MethodAPIKey || keyCaller.CredentialID != created.ID {
		t.Fatalf("authenticate with an API key = %+v %v", keyCaller, err)
	}
	if _, err := accounts.CreateAPIKey(ctx, keyCaller, {{.Package}}.APIKeyInput{Name: "nested"}); !errors.Is(err, auth.ErrForbidden) {
		t.Fatalf("an API key created another key: %v", err)
	}
	past := time.Now().Add(-time.Hour)
	if _, err := accounts.CreateAPIKey(ctx, caller, {{.Package}}.APIKeyInput{Name: "old", ExpiresAt: &past}); err == nil {
		t.Fatal("an expired API key was created")
	}
	keys, err := accounts.ListAPIKeys(ctx, caller)
	if err != nil || len(keys) != 1 || keys[0].ID != created.ID || keys[0].Prefix != created.Prefix {
		t.Fatalf("list API keys = %+v %v", keys, err)
	}
	if err := accounts.DeleteAPIKey(ctx, caller, created.ID); err != nil {
		t.Fatalf("delete API key: %v", err)
	}
	if err := accounts.DeleteAPIKey(ctx, caller, created.ID); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("second delete: %v", err)
	}
	if _, err := accounts.Authenticate(ctx, created.Key); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("a deleted API key still authenticates: %v", err)
	}
{{- if .Auth.JWT}}
	if err := accounts.Revoke(ctx, caller); err != nil {
		t.Fatalf("revoke: %v", err)
	}
	if _, err := accounts.CreateAPIKey(ctx, caller, {{.Package}}.APIKeyInput{Name: "late"}); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("a revoked access token created an API key: %v", err)
	}
{{- end}}
}
