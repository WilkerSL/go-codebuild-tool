func TestAccountsRefreshRotation(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	first, err := accounts.Issue(ctx, {{.OwnHelper}}(t, ctx, db))
	if err != nil {
		t.Fatalf("issue: %v", err)
	}
	second, err := accounts.Refresh(ctx, first.RefreshToken)
	if err != nil || second.RefreshToken == first.RefreshToken {
		t.Fatalf("refresh = %v", err)
	}
	if _, err := accounts.Authenticate(ctx, second.AccessToken); err != nil {
		t.Fatalf("refreshed access token: %v", err)
	}
	retry, err := accounts.Refresh(ctx, first.RefreshToken)
	if err != nil || retry.RefreshToken != second.RefreshToken {
		t.Fatalf("a retry within the grace period must receive the same refresh token: %v", err)
	}
	third, err := accounts.Refresh(ctx, second.RefreshToken)
	if err != nil {
		t.Fatalf("the family was revoked by a retry: %v", err)
	}
	if _, err := accounts.Refresh(ctx, first.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("a token whose successor was already used still refreshed: %v", err)
	}
	if _, err := accounts.Refresh(ctx, third.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("the family survived a replayed refresh token: %v", err)
	}
	for _, bad := range []string{"garbage", auth.RefreshPrefix + "unknown"} {
		if _, err := accounts.Refresh(ctx, bad); !errors.Is(err, auth.ErrInvalidToken) {
			t.Fatalf("refresh(%q) = %v", bad, err)
		}
	}
}

func TestAccountsRefreshReuseRevokesFamily(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	cfg := accountsConfig()
	cfg.RefreshReuseGrace = -time.Second
	accounts := {{.Package}}.NewAccounts(db, cfg)
	first, err := accounts.Issue(ctx, {{.OwnHelper}}(t, ctx, db))
	if err != nil {
		t.Fatalf("issue: %v", err)
	}
	second, err := accounts.Refresh(ctx, first.RefreshToken)
	if err != nil {
		t.Fatalf("refresh = %v", err)
	}
	if _, err := accounts.Refresh(ctx, first.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("reused refresh token = %v", err)
	}
	if _, err := accounts.Refresh(ctx, second.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("the family survived a reuse: %v", err)
	}
}

func TestAccountsRevokeDuringRefresh(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	first, err := accounts.Issue(ctx, {{.OwnHelper}}(t, ctx, db))
	if err != nil {
		t.Fatalf("issue: %v", err)
	}
	caller, err := accounts.Authenticate(ctx, first.AccessToken)
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}
	tx, err := db.BeginTx(ctx, nil)
	if err != nil {
		t.Fatal(err)
	}
	second, err := accounts.RefreshInTx(ctx, tx, first.RefreshToken)
	if err != nil {
		tx.Rollback()
		t.Fatalf("refresh in a transaction: %v", err)
	}
	revoked := make(chan error, 1)
	go func() { revoked <- accounts.Revoke(ctx, caller) }()
	time.Sleep(200 * time.Millisecond)
	if err := tx.Commit(); err != nil {
		t.Fatalf("commit: %v", err)
	}
	if err := <-revoked; err != nil {
		t.Fatalf("revoke: %v", err)
	}
	if _, err := accounts.Refresh(ctx, second.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("a refresh token issued while its family was being revoked survived: %v", err)
	}
}

