func TestAccountsChangePassword(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	in := {{.OwnInputHelper}}(t, ctx, db)
	user, err := {{.Package}}.NewRepository(db).Create(ctx, in)
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	first, _ := accounts.Issue(ctx, user)
	second, _ := accounts.Issue(ctx, user)
	caller, err := accounts.Authenticate(ctx, first.AccessToken)
	if err != nil {
		t.Fatalf("authenticate: %v", err)
	}
	next := "a brand new password"
	cases := []struct {
		change {{.Package}}.PasswordChange
		field  string
	}{
		{change: {{.Package}}.PasswordChange{Current: "wrong password", New: next}, field: "currentPassword"},
		{change: {{.Package}}.PasswordChange{Current: in.{{.Auth.Password.Input}}, New: "short"}, field: "newPassword"},
	}
	for _, c := range cases {
		errs, ok := errors.AsType[validation.Errors](accounts.ChangePassword(ctx, caller, c.change))
		if !ok || !errs.Has(c.field) {
			t.Fatalf("expected an error for %s, got %v", c.field, errs)
		}
	}
	if err := accounts.ChangePassword(ctx, caller, {{.Package}}.PasswordChange{Current: in.{{.Auth.Password.Input}}, New: next}); err != nil {
		t.Fatalf("change password: %v", err)
	}
	if _, err := accounts.VerifyPassword(ctx, in.{{.Auth.Identity.Input}}, next); err != nil {
		t.Fatalf("new password: %v", err)
	}
	if _, err := accounts.VerifyPassword(ctx, in.{{.Auth.Identity.Input}}, in.{{.Auth.Password.Input}}); !errors.Is(err, auth.ErrInvalidCredentials) {
		t.Fatalf("old password still works: %v", err)
	}
{{- if .Auth.Session}}
	if _, err := accounts.Authenticate(ctx, first.AccessToken); err != nil {
		t.Fatalf("the current session was revoked: %v", err)
	}
	if _, err := accounts.Authenticate(ctx, second.AccessToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("other sessions survived a password change: %v", err)
	}
{{- else}}
	if _, err := accounts.Refresh(ctx, first.RefreshToken); err != nil {
		t.Fatalf("the current refresh token was revoked: %v", err)
	}
	if _, err := accounts.Refresh(ctx, second.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("other refresh tokens survived a password change: %v", err)
	}
{{- end}}
}

func TestAccountsAdministration(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	in := {{.OwnInputHelper}}(t, ctx, db)
	user, err := {{.Package}}.NewRepository(db).Create(ctx, in)
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	tokens, _ := accounts.Issue(ctx, user)
{{- if .Auth.Role}}
	if err := accounts.SetRole(ctx, in.{{.Auth.Identity.Input}}, {{.Package}}.{{(index .Auth.Role.EnumConsts 0).Name}}); err != nil {
		t.Fatalf("set role: %v", err)
	}
	if got, _ := {{.Package}}.NewRepository(db).Get(ctx, user.{{.PK.Name}}); got.{{.Auth.Role.Name}} != {{.Package}}.{{(index .Auth.Role.EnumConsts 0).Name}} {
		t.Fatalf("role = %q", got.{{.Auth.Role.Name}})
	}
	if err := accounts.SetRole(ctx, in.{{.Auth.Identity.Input}}, "zz-not-a-role"); err == nil {
		t.Fatal("an unknown role was accepted")
	}
	if err := accounts.SetRole(ctx, "zz"+in.{{.Auth.Identity.Input}}, {{.Package}}.{{(index .Auth.Role.EnumConsts 0).Name}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("set role of a missing account: %v", err)
	}
{{- end}}
	if err := accounts.SetPassword(ctx, in.{{.Auth.Identity.Input}}, "reset password 123"); err != nil {
		t.Fatalf("set password: %v", err)
	}
	if _, err := accounts.VerifyPassword(ctx, in.{{.Auth.Identity.Input}}, "reset password 123"); err != nil {
		t.Fatalf("reset password: %v", err)
	}
{{- if .Auth.Session}}
	if _, err := accounts.Authenticate(ctx, tokens.AccessToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("sessions survived a password reset: %v", err)
	}
{{- else}}
	if _, err := accounts.Refresh(ctx, tokens.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("refresh tokens survived a password reset: %v", err)
	}
{{- end}}
	if err := accounts.RevokeAll(ctx, "zz"+in.{{.Auth.Identity.Input}}); !errors.Is(err, database.ErrNotFound) {
		t.Fatalf("revoke a missing account: %v", err)
	}
}
