func TestAccountsLogin(t *testing.T) {
	db := openFixtureDB(t)
	ctx := context.Background()
	accounts := {{.Package}}.NewAccounts(db, accountsConfig())
	in := {{.OwnInputHelper}}(t, ctx, db)
	created, err := {{.Package}}.NewRepository(db).Create(ctx, in)
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	if created.{{.Auth.Password.Name}} == in.{{.Auth.Password.Input}} || !strings.HasPrefix(created.{{.Auth.Password.Name}}, "pbkdf2-sha256$") {
		t.Fatalf("the password was not hashed: %q", created.{{.Auth.Password.Name}})
	}
	user, err := accounts.VerifyPassword(ctx, {{if .Auth.EmailIdentity}}strings.ToUpper(in.{{.Auth.Identity.Input}}){{else}}in.{{.Auth.Identity.Input}}{{end}}, in.{{.Auth.Password.Input}})
	if err != nil || user.{{.PK.Name}} != created.{{.PK.Name}} {
		t.Fatalf("verify: %v", err)
	}
	if _, err := accounts.VerifyPassword(ctx, in.{{.Auth.Identity.Input}}, in.{{.Auth.Password.Input}}+"x"); !errors.Is(err, auth.ErrInvalidCredentials) {
		t.Fatalf("wrong password: %v", err)
	}
	if _, err := accounts.VerifyPassword(ctx, "zz"+in.{{.Auth.Identity.Input}}, in.{{.Auth.Password.Input}}); !errors.Is(err, auth.ErrInvalidCredentials) {
		t.Fatalf("unknown account: %v", err)
	}
	tokens, err := accounts.Issue(ctx, user)
	if err != nil {
		t.Fatalf("issue: %v", err)
	}
	caller, err := accounts.Authenticate(ctx, tokens.AccessToken)
	if err != nil || caller.ID != created.{{.PK.Name}} || caller.Method != auth.Method{{if .Auth.Session}}Session{{else}}JWT{{end}} {
		t.Fatalf("authenticate = %+v %v", caller, err)
	}
{{- if .Auth.Role}}
	if caller.Role != created.{{.Auth.Role.Name}} {
		t.Fatalf("role = %q, want %q", caller.Role, created.{{.Auth.Role.Name}})
	}
{{- end}}
	for _, bad := range []string{tokens.AccessToken + "x", "garbage", ""} {
		if _, err := accounts.Authenticate(ctx, bad); !errors.Is(err, auth.ErrInvalidToken) {
			t.Fatalf("authenticate(%q) = %v", bad, err)
		}
	}
{{- if .Auth.JWT}}
	if confirmed, err := accounts.Authenticate(auth.WithConfirmation(ctx), tokens.AccessToken); err != nil || confirmed != caller {
		t.Fatalf("confirmed authenticate = %+v %v", confirmed, err)
	}
{{- end}}
	if err := accounts.Revoke(ctx, caller); err != nil {
		t.Fatalf("revoke: %v", err)
	}
{{- if .Auth.Session}}
	if _, err := accounts.Authenticate(ctx, tokens.AccessToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("revoked session still authenticates: %v", err)
	}
{{- else}}
	if _, err := accounts.Refresh(ctx, tokens.RefreshToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("revoked refresh token still works: %v", err)
	}
	if _, err := accounts.Authenticate(auth.WithConfirmation(ctx), tokens.AccessToken); !errors.Is(err, auth.ErrInvalidToken) {
		t.Fatalf("a confirmed access token outlived its revoked session: %v", err)
	}
{{- end}}
}
