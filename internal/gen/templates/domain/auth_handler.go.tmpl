{{- if .Auth.APIKey}}

type apiKeyRequest struct {
	Name      *string `json:"name"`
	ExpiresAt *string `json:"expiresAt"`
}

func (req apiKeyRequest) input() (APIKeyInput, error) {
	var in APIKeyInput
	var errs validation.Errors
	switch {
	case req.Name == nil:
		errs.Add("name", "is required")
	case strings.TrimSpace(*req.Name) == "":
		errs.Add("name", "must not be empty")
	case utf8.RuneCountInString(*req.Name) > 120:
		errs.Add("name", "must be at most 120 characters")
	default:
		in.Name = *req.Name
	}
	if req.ExpiresAt != nil {
		if v, err := time.Parse(time.RFC3339Nano, *req.ExpiresAt); err != nil {
			errs.Add("expiresAt", "must be an RFC 3339 timestamp")
		} else {
			in.ExpiresAt = &v
		}
	}
	return in, errs.Err()
}

type apiKeyList struct {
	Items []APIKey `json:"items"`
}
{{- end}}

type AuthHandler struct {
	svc     *AuthService
	guard   *auth.Guard
	cfg     auth.Config
	logger  *slog.Logger
	logins  *auth.Limiter
	clients *auth.Limiter
}

func NewAuthHandler(svc *AuthService, guard *auth.Guard, cfg auth.Config, logger *slog.Logger) *AuthHandler {
	return &AuthHandler{
		svc:     svc,
		guard:   guard,
		cfg:     cfg,
		logger:  logger,
		logins:  auth.NewLimiter(cfg.LoginLimit, cfg.LoginWindow),
		clients: auth.NewLimiter(cfg.LoginLimit*10, cfg.LoginWindow),
	}
}

func (h *AuthHandler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, err)
}

func (h *AuthHandler) writeTokens(w http.ResponseWriter, tokens auth.Tokens) {
	auth.SetCookie(w, h.cfg, auth.CredentialCookie, tokens.AccessToken, "/", tokens.ExpiresAt)
{{- if .Auth.JWT}}
	auth.SetCookie(w, h.cfg, auth.RefreshCookie, tokens.RefreshToken, "/auth", tokens.RefreshExpiresAt)
{{- end}}
	w.Header().Set("Cache-Control", "no-store")
	httpx.WriteJSON(w, http.StatusOK, tokens)
}
{{- if .Auth.Register}}

func (h *AuthHandler) register(w http.ResponseWriter, r *http.Request) {
	if err := h.clients.Allow(auth.ClientIP(r, h.cfg.TrustForwardedFor)); err != nil {
		h.fail(w, r, err)
		return
	}
	var req registerRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	err = validation.Merge(err, in.Validate())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Register(r.Context(), in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
{{- if .Routes}}
	w.Header().Set("Location", "{{.Path}}/"+{{.PKLocation}})
{{- end}}
	httpx.WriteJSON(w, http.StatusCreated, item)
}
{{- end}}

func (h *AuthHandler) login(w http.ResponseWriter, r *http.Request) {
	var req loginRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	ip := auth.ClientIP(r, h.cfg.TrustForwardedFor)
	key := ip + "|" + normalizeIdentity(in.Identity)
	if err := h.clients.Allow(ip); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.logins.Allow(key); err != nil {
		h.fail(w, r, err)
		return
	}
	tokens, err := h.svc.Login(r.Context(), in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.logins.Reset(key)
	h.writeTokens(w, tokens)
}
{{- if .Auth.JWT}}

func (h *AuthHandler) refresh(w http.ResponseWriter, r *http.Request) {
	token := ""
	if r.ContentLength != 0 {
		var req refreshRequest
		if err := httpx.DecodeJSON(w, r, &req); err != nil {
			h.fail(w, r, err)
			return
		}
		if req.RefreshToken != nil {
			token = *req.RefreshToken
		}
	}
	if token == "" {
		c, err := r.Cookie(auth.RefreshCookie)
		if err != nil || c.Value == "" {
			h.fail(w, r, auth.ErrUnauthenticated)
			return
		}
		if err := h.guard.CheckOrigin(r); err != nil {
			h.fail(w, r, err)
			return
		}
		token = c.Value
	}
	tokens, err := h.svc.Refresh(r.Context(), token)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.writeTokens(w, tokens)
}
{{- end}}

func (h *AuthHandler) logout(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.svc.Logout(r.Context(), caller); err != nil {
		h.fail(w, r, err)
		return
	}
	auth.ClearCookie(w, h.cfg, auth.CredentialCookie, "/")
{{- if .Auth.JWT}}
	auth.ClearCookie(w, h.cfg, auth.RefreshCookie, "/auth")
{{- end}}
	w.WriteHeader(http.StatusNoContent)
}

func (h *AuthHandler) me(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Me(r.Context(), caller)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, item)
}

func (h *AuthHandler) changePassword(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	var req passwordRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.svc.ChangePassword(r.Context(), caller, in); err != nil {
		h.fail(w, r, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
