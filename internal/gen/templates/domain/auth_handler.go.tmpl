type AuthHandler struct {
	svc     *AuthService
	guard   *auth.Guard
	cfg     auth.Config
	logger  *slog.Logger
	logins  *auth.Limiter
	clients *auth.Limiter
}

func NewAuthHandler(svc *AuthService, guard *auth.Guard, cfg auth.Config, logger *slog.Logger, store auth.LimitStore) *AuthHandler {
	// In memory each limiter gets its own store, so a flood of new identities
	// cannot evict the per-client counters that stop it.
	clients := store
	if _, ok := store.(*auth.MemoryStore); ok {
		clients = auth.NewMemoryStore()
	}
	return &AuthHandler{
		svc:     svc,
		guard:   guard,
		cfg:     cfg,
		logger:  logger,
		logins:  auth.NewLimiter("login", cfg.LoginLimit, cfg.LoginWindow, store),
		clients: auth.NewLimiter("client", cfg.LoginLimit*10, cfg.LoginWindow, clients),
	}
}

func (h *AuthHandler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, err)
}

func (h *AuthHandler) resetLimit(r *http.Request, key string) {
	if err := h.logins.Reset(r.Context(), key); err != nil {
		h.logger.WarnContext(r.Context(), "rate limit reset failed", slog.Any("error", err))
	}
}

func (h *AuthHandler) writeTokens(w http.ResponseWriter, tokens auth.Tokens) {
	auth.SetCookie(w, h.cfg, auth.CredentialCookie, tokens.AccessToken, "/", tokens.ExpiresAt)
{{- if .Auth.JWT}}
	auth.SetCookie(w, h.cfg, auth.RefreshCookie, tokens.RefreshToken, "/auth", tokens.RefreshExpiresAt)
{{- end}}
	w.Header().Set("Cache-Control", "no-store")
	httpx.WriteJSON(w, http.StatusOK, tokens)
}
{{- if .Auth.Register}}

func (h *AuthHandler) register(w http.ResponseWriter, r *http.Request) {
	if err := h.clients.Allow(r.Context(), auth.ClientKey(r, h.cfg.TrustForwardedFor)); err != nil {
		h.fail(w, r, err)
		return
	}
	var req registerRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	err = validation.Merge(err, in.Validate())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Register(r.Context(), in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
{{- if .Routes}}
	w.Header().Set("Location", "{{.Path}}/"+{{.PKLocation}})
{{- end}}
	httpx.WriteJSON(w, http.StatusCreated, item)
}
{{- end}}

func (h *AuthHandler) login(w http.ResponseWriter, r *http.Request) {
	var req loginRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	client := auth.ClientKey(r, h.cfg.TrustForwardedFor)
	key := client + "|" + normalizeIdentity(in.Identity)
	if err := h.clients.Allow(r.Context(), client); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.logins.Allow(r.Context(), key); err != nil {
		h.fail(w, r, err)
		return
	}
	tokens, err := h.svc.Login(r.Context(), in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.resetLimit(r, key)
	h.writeTokens(w, tokens)
}
{{- if .Auth.JWT}}

func (h *AuthHandler) refresh(w http.ResponseWriter, r *http.Request) {
	token := ""
	if r.ContentLength != 0 {
		var req refreshRequest
		if err := httpx.DecodeJSON(w, r, &req); err != nil {
			h.fail(w, r, err)
			return
		}
		if req.RefreshToken != nil {
			token = *req.RefreshToken
		}
	}
	if token == "" {
		c, err := r.Cookie(auth.RefreshCookie)
		if err != nil || c.Value == "" {
			h.fail(w, r, auth.ErrUnauthenticated)
			return
		}
		if err := h.guard.CheckOrigin(r); err != nil {
			h.fail(w, r, err)
			return
		}
		token = c.Value
	}
	tokens, err := h.svc.Refresh(r.Context(), token)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	h.writeTokens(w, tokens)
}
{{- end}}

func (h *AuthHandler) logout(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.svc.Logout(r.Context(), caller); err != nil {
		h.fail(w, r, err)
		return
	}
	auth.ClearCookie(w, h.cfg, auth.CredentialCookie, "/")
{{- if .Auth.JWT}}
	auth.ClearCookie(w, h.cfg, auth.RefreshCookie, "/auth")
{{- end}}
	w.WriteHeader(http.StatusNoContent)
}

func (h *AuthHandler) me(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Me(r.Context(), caller)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, item)
}

func (h *AuthHandler) changePassword(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	var req passwordRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	key := "password|" + caller.CredentialID
	if err := h.clients.Allow(r.Context(), auth.ClientKey(r, h.cfg.TrustForwardedFor)); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.logins.Allow(r.Context(), key); err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.svc.ChangePassword(r.Context(), caller, in); err != nil {
		h.fail(w, r, err)
		return
	}
	h.resetLimit(r, key)
	w.WriteHeader(http.StatusNoContent)
}
{{- if .Auth.APIKey}}

func (h *AuthHandler) createAPIKey(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	var req apiKeyRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.CreateAPIKey(r.Context(), caller, in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("Location", "/auth/api-keys/"+url.PathEscape(item.ID))
	httpx.WriteJSON(w, http.StatusCreated, item)
}

func (h *AuthHandler) listAPIKeys(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	items, err := h.svc.ListAPIKeys(r.Context(), caller)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, apiKeyList{Items: items})
}

func (h *AuthHandler) deleteAPIKey(w http.ResponseWriter, r *http.Request) {
	caller, err := auth.Current(r.Context())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	id, err := httpx.PathString(r, "id")
	if err != nil {
		h.fail(w, r, err)
		return
	}
	if err := h.svc.DeleteAPIKey(r.Context(), caller, id); err != nil {
		h.fail(w, r, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
