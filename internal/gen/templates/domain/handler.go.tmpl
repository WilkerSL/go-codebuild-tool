func (h *Handler) update(w http.ResponseWriter, r *http.Request) {
	id, err := {{.PKParse}}
	if err != nil {
		h.fail(w, r, err)
		return
	}
	var req updateRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err == nil {
		err = in.Validate()
	}
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Update(r.Context(), id, in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, item)
}
