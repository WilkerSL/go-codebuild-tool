type Handler struct {
	svc    *Service
	logger *slog.Logger
}

func NewHandler(svc *Service, logger *slog.Logger) *Handler {
	return &Handler{svc: svc, logger: logger}
}

func (h *Handler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, err)
}

func listParams(r *http.Request) (ListParams, error) {
	q := r.URL.Query()
	var errs validation.Errors
	var p ListParams
	p.Limit, p.Offset = httpx.Pagination(q, &errs)
{{- range .Filters}}
	{{.FilterParse}}
{{- end}}
	if len(errs) > 0 {
		return ListParams{}, httpx.BadRequest("the query string contains invalid parameters", errs...)
	}
	return p, nil
}

func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
	p, err := listParams(r)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	page, err := h.svc.List(r.Context(), p)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, page)
}

func (h *Handler) get(w http.ResponseWriter, r *http.Request) {
	id, err := {{.PKParse}}
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Get(r.Context(), id)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, item)
}
{{- if not .ReadOnly}}

func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
	var req createRequest
	if err := httpx.DecodeJSON(w, r, &req); err != nil {
		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	if err == nil {
		err = in.Validate()
	}
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Create(r.Context(), in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	w.Header().Set("Location", "{{.Path}}/"+{{.PKLocation}})
	httpx.WriteJSON(w, http.StatusCreated, item)
}
