		h.fail(w, r, err)
		return
	}
	in, err := req.input()
	err = validation.Merge(err, in.Validate())
	if err != nil {
		h.fail(w, r, err)
		return
	}
	item, err := h.svc.Create(r.Context(), {{if .Owned}}caller.ID, {{end}}in)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	w.Header().Set("Location", "{{.Path}}/"+{{.PKLocation}})
	httpx.WriteJSON(w, http.StatusCreated, item)
}
