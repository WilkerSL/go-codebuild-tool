type Handler struct {
	svc    *Service
	logger *slog.Logger
	idem   *database.Idempotency
}

func NewHandler(svc *Service, logger *slog.Logger) *Handler {
	return &Handler{svc: svc, logger: logger}
}

func (h *Handler) UseIdempotency(store *database.Idempotency) *Handler {
	h.idem = store
	return h
}

func (h *Handler) idempotent(next http.HandlerFunc) http.HandlerFunc {
	return httpx.Idempotent(h.idem, h.logger, {{if .Guarded}}auth.Caller{{else}}nil{{end}}, next)
}

func (h *Handler) fail(w http.ResponseWriter, r *http.Request, err error) {
	httpx.WriteError(w, r, h.logger, err)
}

func listParams(r *http.Request) (ListParams, error) {
	q := r.URL.Query()
	var errs validation.Errors
	var p ListParams
	p.Limit, p.Offset = httpx.Pagination(q, &errs)
	if raw := httpx.Cursor(q, &errs); raw != "" {
		cursor, err := ParseCursor(raw)
		if err != nil {
			errs.Add("cursor", "is invalid")
		} else {
			p.Cursor = &cursor
		}
	}
{{- range .Filters}}
	{{.FilterParse}}
{{- end}}
	if len(errs) > 0 {
		return ListParams{}, httpx.BadRequest("the query string contains invalid parameters", errs...)
	}
	return p, nil
}

func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
{{- if .Owned}}{{template "caller"}}{{end}}
	p, err := listParams(r)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	page, err := h.svc.List(r.Context(), {{if .Owned}}caller.ID, {{end}}p)
	if err != nil {
		h.fail(w, r, err)
		return
	}
	httpx.WriteJSON(w, http.StatusOK, page)
}

