func fixtureString(n int) string {
	b := make([]byte, (n+1)/2)
	rand.Read(b)
	return hex.EncodeToString(b)[:n]
}

func fixtureEmail(limit int) string {
	domain := "@example.com"
	if limit < len(domain)+4 {
		domain = "@x.io"
	}
	return fixtureString(max(1, min(16, limit-len(domain)))) + domain
}

func fixtureInt[T int16 | int32 | int | int64](lo, hi int64) T {
	return T(lo + mrand.Int64N(hi-lo+1))
}

func validCreateInput() CreateInput {
	return CreateInput{
{{- range .Create}}{{if not .F.Nullable}}
		{{.Name}}: {{.ValidValue}},
{{- end}}{{end}}
	}
}

func TestCreateInputValidate(t *testing.T) {
	if err := validCreateInput().Validate(); err != nil {
		t.Fatalf("valid input rejected: %v", err)
	}
	tests := []struct {
		name   string
		field  string
		mutate func(*CreateInput)
	}{
{{- range .Create}}{{$f := .}}{{range .FailingCases}}
		{name: "{{$f.Name}} {{.Rule}}", field: "{{$f.JSON}}", mutate: func(in *CreateInput) { in.{{$f.Name}} = {{.Assign}} }},
{{- end}}{{end}}
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			in := validCreateInput()
			tt.mutate(&in)
			errs, ok := errors.AsType[validation.Errors](in.Validate())
			if !ok || !errs.Has(tt.field) {
				t.Fatalf("expected an error for %s, got %v", tt.field, errs)
			}
		})
	}
}

func TestCreateRequestRequiredFields(t *testing.T) {
	_, err := createRequest{}.input()
{{- if .RequiredCreate}}
	errs, ok := errors.AsType[validation.Errors](err)
	if !ok {
		t.Fatalf("expected required field errors, got %v", err)
	}
	for _, field := range []string{ {{- range $i, $f := .RequiredCreate}}{{if $i}}, {{end}}"{{$f.JSON}}"{{end -}} } {
		if !errs.Has(field) {
			t.Errorf("missing required error for %s", field)
		}
	}
{{- else}}
