func (r *Repository) exists(ctx context.Context, query string, args ...any) error {
	var one int
	err := r.db.QueryRowContext(ctx, query, args...).Scan(&one)
	if errors.Is(err, sql.ErrNoRows) {
		return database.ErrNotFound
	}
	if err != nil {
		return fmt.Errorf("check {{.Noun}} reference: %w", err)
	}
	return nil
}

func (r *Repository) page(ctx context.Context, p ListParams, listSQL string, listArgs []any, countSQL string, countArgs []any) (Page, error) {
	rows, err := r.db.QueryContext(ctx, listSQL, listArgs...)
	if err != nil {
		return Page{}, fmt.Errorf("list {{.Nouns}}: %w", err)
	}
	defer rows.Close()
	items := make([]{{.Name}}, 0, max(0, min(p.Limit, 100)))
	for rows.Next() {
		item, err := scan{{.Name}}(rows.Scan)
		if err != nil {
			return Page{}, fmt.Errorf("list {{.Nouns}}: %w", err)
		}
		items = append(items, item)
	}
	if err := rows.Err(); err != nil {
		return Page{}, fmt.Errorf("list {{.Nouns}}: %w", err)
	}
	var total int64
	if err := r.db.QueryRowContext(ctx, countSQL, countArgs...).Scan(&total); err != nil {
		return Page{}, fmt.Errorf("count {{.Nouns}}: %w", err)
	}
	return Page{Items: items, Limit: p.Limit, Offset: p.Offset, Total: total}, nil
}
