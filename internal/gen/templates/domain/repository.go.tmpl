		repo := &Repository{db: db}
		if err := repo.exists(ctx, existsQuery, {{.ExistsArgs}}); err != nil {
			return err
		}
{{- range .DeleteRules}}
{{- if .Restrict}}
		if err := repo.referenced(ctx, {{.Const}}, {{.Args}}); err != nil {
			return err
		}
{{- else}}
		if _, err := db.ExecContext(ctx, {{.Const}}, {{.Args}}); err != nil {
			return fmt.Errorf("delete {{$.Noun}}: %w", err)
		}
{{- end}}
{{- end}}
		return repo.delete(ctx, {{.OwnerArg}}id)
	})
}
