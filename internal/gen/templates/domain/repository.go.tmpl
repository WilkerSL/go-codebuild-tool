func (r *Repository) referenced(ctx context.Context, query string, args ...any) error {
	var n int64
	if err := r.db.QueryRowContext(ctx, query, args...).Scan(&n); err != nil {
		return fmt.Errorf("delete {{.Noun}}: %w", err)
	}
	if n > 0 {
		return fmt.Errorf("delete {{.Noun}}: %w", database.ErrReferenced)
	}
	return nil
}
{{- end}}

func (r *Repository) delete(ctx context.Context, {{.OwnerParam}}id {{.PK.BaseType}}) error {
{{- end}}
	res, err := r.db.ExecContext(ctx, deleteQuery, {{.DeleteArgs}})
	if err != nil {
		if ce, ok := database.Constraint(err); ok && ce.Kind == database.ForeignKeyViolation {
			return fmt.Errorf("delete {{.Noun}}: %w", database.ErrReferenced)
		}
		return fmt.Errorf("delete {{.Noun}}: %w", err)
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("delete {{.Noun}}: %w", err)
	}
	if n == 0 {
		return database.ErrNotFound
	}
	return nil
}
