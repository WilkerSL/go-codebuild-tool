func checkNewPassword(field, password string) error {
	n := utf8.RuneCountInString(password)
	switch {
	case n < auth.MinPasswordLength:
		return validation.Errors{ {Field: field, Message: "must be at least " + strconv.Itoa(auth.MinPasswordLength) + " characters"} }
	case n > auth.MaxPasswordLength:
		return validation.Errors{ {Field: field, Message: "must be at most " + strconv.Itoa(auth.MaxPasswordLength) + " characters"} }
	}
	return nil
}
