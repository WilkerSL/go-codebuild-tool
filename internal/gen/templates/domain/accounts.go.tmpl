func (a *Accounts) SetPassword(ctx context.Context, identity, password string) error {
	item, err := a.findByIdentity(ctx, identity)
	if err != nil {
		return err
	}
	if err := checkNewPassword("password", password); err != nil {
		return err
	}
	if err := a.setPassword(ctx, item.{{.PK.Name}}, password); err != nil {
		return err
	}
	return a.revokeAll(ctx, item.{{.PK.Name}})
}

func (a *Accounts) RevokeAll(ctx context.Context, identity string) error {
	item, err := a.findByIdentity(ctx, identity)
	if err != nil {
		return err
	}
	return a.revokeAll(ctx, item.{{.PK.Name}})
}

func (a *Accounts) revokeAll(ctx context.Context, id {{.Auth.IDType}}) error {
	for _, query := range []string{ {{- if .Auth.Session}}deleteUserSessionsQuery, {{end}}{{if .Auth.JWT}}deleteUserRefreshQuery, {{end}}{{if .Auth.APIKey}}deleteUserAPIKeysQuery{{end -}} } {
		if err := a.revokeRows(ctx, query, {{$id}}); err != nil {
			return fmt.Errorf("revoke credentials: %w", err)
		}
	}
	return nil
}

func (a *Accounts) revokeRows(ctx context.Context, query string, args ...any) error {
	for range maxRevokePasses {
		res, err := a.q.ExecContext(ctx, query, args...)
		if err != nil {
			return err
		}
		n, err := res.RowsAffected()
		if err != nil {
			return err
		}
		if n == 0 {
			return nil
		}
	}
	return fmt.Errorf("rows were still being added after %d passes", maxRevokePasses)
}
