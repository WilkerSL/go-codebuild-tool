func (a *Accounts) refreshRow(ctx context.Context, db database.DBTX, hash string, now time.Time) (refreshRow, error) {
	var row refreshRow
	err := db.QueryRowContext(ctx, refreshTokenQuery, hash, database.TimeArg(now)).Scan(&row.family, {{if .Auth.ScanTime}}database.ScanNullTime(&row.used){{else}}&row.used{{end}}, {{.Auth.IDScanOpen}}&row.id{{.Auth.IDScanClose}}{{if .Auth.Role}}, &row.role{{end}})
	if errors.Is(err, sql.ErrNoRows) {
		return refreshRow{}, auth.ErrInvalidToken
	}
	if err != nil {
		return refreshRow{}, fmt.Errorf("refresh tokens: %w", err)
	}
	return row, nil
}

func (a *Accounts) Refresh(ctx context.Context, token string) (auth.Tokens, error) {
	if !strings.HasPrefix(token, auth.RefreshPrefix) || len(token) > 256 {
		return auth.Tokens{}, auth.ErrInvalidToken
	}
	issued := authNow()
	hash := auth.HashToken(token)
	row, err := a.refreshRow(ctx, a.q, hash, issued)
	if err != nil {
		return auth.Tokens{}, err
	}
	next := auth.NextRefreshToken(a.cfg.Secret, token)
	reused := row.used != nil && issued.Sub(*row.used) > a.cfg.RefreshReuseGrace
	var tokens auth.Tokens
	if !reused {
		err = database.InTx(ctx, a.db, func(tx *sql.Tx) error {
			var err error
			tokens, reused, err = a.rotate(ctx, database.Traced(tx), row, hash, next, issued)
			return err
		})
		if err != nil {
			return auth.Tokens{}, err
		}
	}
	if reused {
		if err := a.revokeRows(ctx, deleteFamilyQuery, row.family); err != nil {
			return auth.Tokens{}, fmt.Errorf("revoke reused refresh token: %w", err)
		}
		return auth.Tokens{}, auth.ErrInvalidToken
	}
	return tokens, nil
}

func (a *Accounts) rotate(ctx context.Context, tx database.DBTX, row refreshRow, hash, next string, issued time.Time) (auth.Tokens, bool, error) {
	res, err := tx.ExecContext(ctx, useRefreshQuery, database.TimeArg(issued), hash)
	if err != nil {
		return auth.Tokens{}, false, fmt.Errorf("refresh tokens: %w", err)
	}
	n, err := res.RowsAffected()
	if err != nil {
		return auth.Tokens{}, false, fmt.Errorf("refresh tokens: %w", err)
	}
	if n == 1 {
		tokens, err := a.issueTokens(ctx, tx, row.id{{if .Auth.Role}}, row.role{{end}}, row.family, next, issued)
		return tokens, false, err
	}
	var (
		nextUsed    *time.Time
		nextExpires time.Time
	)
	err = tx.QueryRowContext(ctx, refreshSuccessorQuery, auth.HashToken(next), row.family).Scan({{if .Auth.ScanTime}}database.ScanNullTime(&nextUsed), database.ScanTime(&nextExpires){{else}}&nextUsed, &nextExpires{{end}})
	if errors.Is(err, sql.ErrNoRows) || (err == nil && nextUsed != nil) {
		return auth.Tokens{}, true, nil
	}
	if err != nil {
		return auth.Tokens{}, false, fmt.Errorf("refresh tokens: %w", err)
	}
	tokens, err := a.signTokens(row.id{{if .Auth.Role}}, row.role{{end}}, row.family, next, nextExpires.UTC(), issued)
	return tokens, false, err
}


func (a *Accounts) confirm(ctx context.Context, p auth.Principal) (auth.Principal, error) {
	err := a.q.QueryRowContext(ctx, jwtPrincipalQuery, {{.Auth.IDArgOpen}}p.ID{{.Auth.IDArgClose}}, p.CredentialID, database.TimeArg(authNow())).Scan({{.Auth.IDScanOpen}}&p.ID{{.Auth.IDScanClose}}{{if .Auth.Role}}, &p.Role{{end}})
	return foundPrincipal(p, err)
}
{{- end}}

func (a *Accounts) Authenticate(ctx context.Context, token string) (auth.Principal, error) {
	switch {
{{- if .Auth.Session}}
	case strings.HasPrefix(token, auth.SessionPrefix):
		p := auth.Principal{Method: auth.MethodSession, CredentialID: auth.HashToken(token)}
		err := a.q.QueryRowContext(ctx, sessionPrincipalQuery, p.CredentialID, database.TimeArg(authNow())).Scan({{.Auth.IDScanOpen}}&p.ID{{.Auth.IDScanClose}}{{if .Auth.Role}}, &p.Role{{end}})
		return foundPrincipal(p, err)
{{- end}}
{{- if .Auth.APIKey}}
	case strings.HasPrefix(token, auth.APIKeyPrefix):
		p := auth.Principal{Method: auth.MethodAPIKey}
		err := a.q.QueryRowContext(ctx, apiKeyPrincipalQuery, auth.HashToken(token), database.TimeArg(authNow())).Scan(&p.CredentialID, {{.Auth.IDScanOpen}}&p.ID{{.Auth.IDScanClose}}{{if .Auth.Role}}, &p.Role{{end}})
		return foundPrincipal(p, err)
{{- end}}
{{- if .Auth.JWT}}
	case strings.Count(token, ".") == 2:
		claims, err := auth.ParseJWT(token, time.Now(), a.cfg.Secret, a.cfg.PreviousSecret)
		if err != nil {
			return auth.Principal{}, err
		}
		id, err := parseAccountID(claims.Subject)
		if err != nil {
			return auth.Principal{}, auth.ErrInvalidToken
		}
		p := auth.Principal{ID: id{{if .Auth.Role}}, Role: claims.Role{{end}}, Method: auth.MethodJWT, CredentialID: claims.Session}
		if auth.ConfirmationRequired(ctx) {
			return a.confirm(ctx, p)
		}
		return p, nil
{{- end}}
	}
	return auth.Principal{}, auth.ErrInvalidToken
}

func foundPrincipal(p auth.Principal, err error) (auth.Principal, error) {
	if errors.Is(err, sql.ErrNoRows) {
		return auth.Principal{}, auth.ErrInvalidToken
	}
	if err != nil {
		return auth.Principal{}, fmt.Errorf("authenticate: %w", err)
	}
	return p, nil
}

func (a *Accounts) Revoke(ctx context.Context, caller auth.Principal) error {
	switch caller.Method {
{{- if .Auth.Session}}
	case auth.MethodSession:
		if _, err := a.q.ExecContext(ctx, deleteSessionQuery, caller.CredentialID); err != nil {
			return fmt.Errorf("revoke session: %w", err)
		}
{{- end}}
{{- if .Auth.JWT}}
	case auth.MethodJWT:
		if err := a.revokeRows(ctx, deleteFamilyQuery, caller.CredentialID); err != nil {
			return fmt.Errorf("revoke tokens: %w", err)
		}
{{- end}}
	default:
		return httpx.BadRequest("only login credentials can be revoked here{{if .Auth.APIKey}}; delete API keys with DELETE /auth/api-keys/{id}{{end}}")
	}
	return nil
}

func (a *Accounts) ChangePassword(ctx context.Context, caller auth.Principal, in PasswordChange) error {
{{- if .Auth.APIKey}}
	if caller.Method == auth.MethodAPIKey {
		return auth.ErrForbidden
	}
{{- end}}
	item, err := a.repo.Get(ctx, caller.ID)
	if errors.Is(err, database.ErrNotFound) {
		return auth.ErrInvalidToken
	}
	if err != nil {
		return err
	}
	if ok, _ := auth.VerifyPassword(item.{{.Auth.Password.Name}}, in.Current); !ok {
		return validation.Errors{ {Field: "currentPassword", Message: "is incorrect"} }
	}
	if err := checkNewPassword("newPassword", in.New); err != nil {
		return err
	}
	if err := a.setPassword(ctx, caller.ID, in.New); err != nil {
		return err
	}
{{- if .Auth.Session}}
	if _, err := a.q.ExecContext(ctx, deleteOtherSessionsQuery, {{$callerID}}, caller.CredentialID); err != nil {
		return fmt.Errorf("revoke other sessions: %w", err)
	}
{{- else}}
	if err := a.revokeRows(ctx, deleteOtherFamiliesQuery, {{$callerID}}, caller.CredentialID); err != nil {
		return fmt.Errorf("revoke other refresh tokens: %w", err)
	}
{{- end}}
{{- if .Auth.APIKey}}
	if err := a.revokeRows(ctx, deleteUserAPIKeysQuery, {{$callerID}}); err != nil {
		return fmt.Errorf("revoke API keys: %w", err)
	}
{{- end}}
	return nil
}
