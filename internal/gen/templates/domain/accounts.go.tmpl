func (a *Accounts) Issue(ctx context.Context, user {{.Name}}) (auth.Tokens, error) {
	issued := authNow()
{{- if .Auth.Session}}
	if _, err := a.q.ExecContext(ctx, deleteExpiredSessionsQuery, {{$userID}}, database.TimeArg(issued)); err != nil {
		return auth.Tokens{}, fmt.Errorf("issue session: %w", err)
	}
	token := auth.NewToken(auth.SessionPrefix)
	expires := issued.Add(a.cfg.SessionTTL)
	if _, err := a.q.ExecContext(ctx, insertSessionQuery, auth.HashToken(token), {{$userID}}, database.TimeArg(issued), database.TimeArg(expires)); err != nil {
		return auth.Tokens{}, fmt.Errorf("issue session: %w", err)
	}
	return auth.Tokens{AccessToken: token, TokenType: "Bearer", ExpiresAt: expires}, nil
{{- else}}
	if _, err := a.q.ExecContext(ctx, deleteExpiredRefreshQuery, {{$userID}}, database.TimeArg(issued)); err != nil {
		return auth.Tokens{}, fmt.Errorf("issue tokens: %w", err)
	}
	return a.issueTokens(ctx, a.q, user.{{.PK.Name}}{{if .Auth.Role}}, user.{{.Auth.Role.Name}}{{end}}, auth.NewID(), auth.NewToken(auth.RefreshPrefix), issued)
{{- end}}
}
