func (a *Accounts) CreateAPIKey(ctx context.Context, caller auth.Principal, in APIKeyInput) (CreatedAPIKey, error) {
	if caller.Method == auth.MethodAPIKey {
		return CreatedAPIKey{}, auth.ErrForbidden
	}
{{- if .Auth.JWT}}
	if caller.Method == auth.MethodJWT {
		if _, err := a.confirm(ctx, caller); err != nil {
			return CreatedAPIKey{}, err
		}
	}
{{- end}}
	created := authNow()
	if in.ExpiresAt != nil && !in.ExpiresAt.After(created) {
		return CreatedAPIKey{}, validation.Errors{ {Field: "expiresAt", Message: "must be in the future"} }
	}
	var count int
	if err := a.q.QueryRowContext(ctx, countAPIKeysQuery, {{$callerID}}).Scan(&count); err != nil {
		return CreatedAPIKey{}, fmt.Errorf("count API keys: %w", err)
	}
	if count >= maxAPIKeys {
		return CreatedAPIKey{}, httpx.NewError(http.StatusConflict, fmt.Sprintf("an account holds at most %d API keys; delete unused keys first", maxAPIKeys))
	}
	key := auth.NewToken(auth.APIKeyPrefix)
	item := CreatedAPIKey{ID: auth.NewID(), Name: in.Name, Prefix: key[:12], CreatedAt: created, Key: key}
	if in.ExpiresAt != nil {
		expires := in.ExpiresAt.UTC().Truncate(time.Microsecond)
		item.ExpiresAt = &expires
	}
	if _, err := a.q.ExecContext(ctx, insertAPIKeyQuery, item.ID, {{$callerID}}, item.Name, item.Prefix, auth.HashToken(key), database.TimeArg(created), database.NullTimeArg(item.ExpiresAt)); err != nil {
		return CreatedAPIKey{}, fmt.Errorf("create API key: %w", err)
	}
	return item, nil
}

func (a *Accounts) ListAPIKeys(ctx context.Context, caller auth.Principal) ([]APIKey, error) {
	if caller.Method == auth.MethodAPIKey {
		return nil, auth.ErrForbidden
	}
	rows, err := a.q.QueryContext(ctx, listAPIKeysQuery, {{$callerID}})
	if err != nil {
		return nil, fmt.Errorf("list API keys: %w", err)
	}
	defer rows.Close()
	keys := []APIKey{}
	for rows.Next() {
		var k APIKey
		if err := rows.Scan(&k.ID, &k.Name, &k.Prefix, {{if .Auth.ScanTime}}database.ScanTime(&k.CreatedAt), database.ScanNullTime(&k.ExpiresAt){{else}}&k.CreatedAt, &k.ExpiresAt{{end}}); err != nil {
			return nil, fmt.Errorf("list API keys: %w", err)
		}
		keys = append(keys, k)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("list API keys: %w", err)
	}
	return keys, nil
}

func (a *Accounts) DeleteAPIKey(ctx context.Context, caller auth.Principal, id string) error {
	if caller.Method == auth.MethodAPIKey {
