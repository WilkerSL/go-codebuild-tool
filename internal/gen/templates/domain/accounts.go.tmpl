func (a *Accounts) VerifyPassword(ctx context.Context, identity, password string) ({{.Name}}, error) {
	item, err := a.findByIdentity(ctx, identity)
	if errors.Is(err, database.ErrNotFound) {
		auth.RejectPassword(password)
		return {{.Name}}{}, auth.ErrInvalidCredentials
	}
	if err != nil {
		return {{.Name}}{}, err
	}
	ok, rehash := auth.VerifyPassword(item.{{.Auth.Password.Name}}, password)
	if !ok {
		return {{.Name}}{}, auth.ErrInvalidCredentials
	}
	if rehash {
		if err := a.setPassword(ctx, item.{{.PK.Name}}, password); err != nil {
			return {{.Name}}{}, err
		}
	}
	return item, nil
}

