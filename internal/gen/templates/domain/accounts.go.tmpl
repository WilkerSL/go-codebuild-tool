func (a *Accounts) issueTokens(ctx context.Context, db database.DBTX, id {{.Auth.IDType}}{{if .Auth.Role}}, role string{{end}}, family, refresh string, issued time.Time) (auth.Tokens, error) {
	refreshExpires := issued.Add(a.cfg.RefreshTTL)
	if _, err := db.ExecContext(ctx, insertRefreshQuery, auth.HashToken(refresh), family, {{$id}}, database.TimeArg(issued), database.TimeArg(refreshExpires)); err != nil {
		return auth.Tokens{}, fmt.Errorf("issue tokens: %w", err)
	}
	return a.signTokens(id{{if .Auth.Role}}, role{{end}}, family, refresh, refreshExpires, issued)
}

func (a *Accounts) signTokens(id {{.Auth.IDType}}{{if .Auth.Role}}, role string{{end}}, family, refresh string, refreshExpires, issued time.Time) (auth.Tokens, error) {
	expires := issued.Add(a.cfg.AccessTTL).Truncate(time.Second)
	access, err := auth.SignJWT(a.cfg.Secret, auth.Claims{
		Subject: formatAccountID(id),
{{- if .Auth.Role}}
		Role: role,
{{- end}}
		Session:   family,
		ID:        auth.NewID(),
		IssuedAt:  issued.Unix(),
		ExpiresAt: expires.Unix(),
	})
	if err != nil {
		return auth.Tokens{}, err
	}
	return auth.Tokens{AccessToken: access, TokenType: "Bearer", ExpiresAt: expires, RefreshToken: refresh, RefreshExpiresAt: refreshExpires}, nil
}

type refreshRow struct {
	family string
