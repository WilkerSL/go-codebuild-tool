{{.Header}}

package {{.Package}}

import "net/http"

func RegisterRoutes(mux *http.ServeMux, h *Handler) {
	mux.HandleFunc("GET {{.Path}}", h.list)
{{- if not .ReadOnly}}
	mux.HandleFunc("POST {{.Path}}", h.create)
{{- end}}
	mux.HandleFunc("GET {{.ItemPath}}", h.get)
{{- if .HasUpdate}}
	mux.HandleFunc("PUT {{.ItemPath}}", h.update)
{{- end}}
{{- if not .ReadOnly}}
	mux.HandleFunc("DELETE {{.ItemPath}}", h.delete)
{{- end}}
{{- range .Relations}}
	mux.HandleFunc("GET {{.Path}}", h.{{.Handler}})
{{- if .Writable}}
	mux.HandleFunc("PUT {{.ItemPath}}", h.{{.LinkHandler}})
	mux.HandleFunc("DELETE {{.ItemPath}}", h.{{.UnlinkHandler}})
{{- end}}
{{- end}}
}
