type loginRequest struct {
	Identity *string `json:"{{.Auth.Identity.InputJSON}}"`
	Password *string `json:"{{.Auth.Password.InputJSON}}"`
}

func (req loginRequest) input() (LoginInput, error) {
	var in LoginInput
	var errs validation.Errors
	if req.Identity == nil || *req.Identity == "" {
		errs.Add("{{.Auth.Identity.InputJSON}}", "is required")
	} else if utf8.RuneCountInString(*req.Identity) > {{.Auth.IdentityMax}} {
		errs.Add("{{.Auth.Identity.InputJSON}}", "must be at most {{.Auth.IdentityMax}} characters")
	} else {
		in.Identity = *req.Identity
	}
	if req.Password == nil || *req.Password == "" {
		errs.Add("{{.Auth.Password.InputJSON}}", "is required")
	} else {
		in.Password = *req.Password
	}
	return in, errs.Err()
}

type passwordRequest struct {
	CurrentPassword *string `json:"currentPassword"`
	NewPassword     *string `json:"newPassword"`
}

func (req passwordRequest) input() (PasswordChange, error) {
	var in PasswordChange
	var errs validation.Errors
	if req.CurrentPassword == nil {
		errs.Add("currentPassword", "is required")
	} else {
		in.Current = *req.CurrentPassword
	}
	if req.NewPassword == nil {
		errs.Add("newPassword", "is required")
	} else {
		in.New = *req.NewPassword
	}
	return in, errs.Err()
}
