{{.Header}}

package {{.Package}}

import "net/http"

func RegisterAuthRoutes(mux *http.ServeMux, h *AuthHandler) {
{{- if .Auth.Register}}
	mux.HandleFunc("POST /auth/register", h.register)
{{- end}}
	mux.HandleFunc("POST /auth/login", h.login)
{{- if .Auth.JWT}}
	mux.HandleFunc("POST /auth/refresh", h.refresh)
{{- end}}
	mux.Handle("POST /auth/logout", h.guard.Protect(h.logout))
	mux.Handle("GET /auth/me", h.guard.Protect(h.me))
	mux.Handle("PUT /auth/password", h.guard.Protect(h.changePassword))
{{- if .Auth.APIKey}}
	mux.Handle("POST /auth/api-keys", h.guard.Protect(h.createAPIKey))
	mux.Handle("GET /auth/api-keys", h.guard.Protect(h.listAPIKeys))
	mux.Handle("DELETE /auth/api-keys/{id}", h.guard.Protect(h.deleteAPIKey))
{{- end}}
}
